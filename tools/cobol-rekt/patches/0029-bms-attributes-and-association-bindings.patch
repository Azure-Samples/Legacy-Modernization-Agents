+package org.smojol.toolkit.analysis.pipeline;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.antlr.v4.runtime.ParserRuleContext;
+import org.antlr.v4.runtime.tree.ParseTree;
+import org.antlr.v4.runtime.tree.TerminalNode;
+import org.smojol.common.ast.NodeText;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Locale;
+import java.util.Set;
+import java.util.TreeMap;
+
+final class BmsAttributeContract {
+    static final List<String> DOCUMENTATION = List.of(
+            "https://www.ibm.com/docs/en/cics-ts/6.x?topic=characteristics-attribute-value-definitions-dfhbmsca",
+            "https://www.ibm.com/docs/en/cics-ts/6.x?topic=output-setting-display-characteristics",
+            "https://www.ibm.com/docs/en/cics-tx/11.1.0?topic=constants-field-attributes-printer-control-characters");
+
+    static Map<String, String> symbols() {
+        return new TreeMap<>(Map.of("DFHBMASK", "A:AUTOSKIP", "DFHBMPRF", "A:PROTECTED_MDT_SET",
+                "DFHBMFSE", "A:MDT_SET", "DFHNEUTR", "C:NEUTRAL", "DFHGREEN", "C:GREEN",
+                "DFHUNDLN", "H:UNDERSCORE"));
+    }
+
+    static boolean validDefinition(JsonObject definition) {
+        JsonObject expected = new JsonObject();
+        expected.addProperty("recipe", "symbolic-bms-attributes-v1");
+        expected.addProperty("selector", "bms-output-field");
+        expected.add("symbols", new com.google.gson.Gson().toJsonTree(symbols()));
+        expected.add("documentation", new com.google.gson.Gson().toJsonTree(DOCUMENTATION));
+        expected.addProperty("targetSemantics", "preserve-field-attribute-assignments");
+        return expected.equals(definition);
+    }
+
+    static void validateUses(ParseTree tree, Map<String, Object> binding, List<Path> directories,
+                             List<String> diagnostics) {
+        List<String> issues = new ArrayList<>();
+        List<Map<String, Object>> usages = new ArrayList<>();
+        CobolDeclarationIndex index = new CobolDeclarationIndex(tree);
+        Map<String, List<Map<String, Object>>> fields = new LinkedHashMap<>();
+        try {
+            for (Path directory : directories) {
+                if (!Files.isDirectory(directory)) continue;
+                try (var files = Files.list(directory)) {
+                    for (Path layout : files.filter(path -> path.toString().endsWith(".cpy.bms-layout.json")).toList()) {
+                        JsonObject proof = JsonParser.parseString(Files.readString(layout)).getAsJsonObject();
+                        Path output = Path.of(layout.toString().replaceFirst("\\.bms-layout\\.json$", ""));
+                        if (!"complete".equals(proof.get("status").getAsString())
+                                || !"bms-symbolic-map/layout-v1".equals(proof.get("producer").getAsString())
+                                || !proof.get("outputSha256").getAsString().equals(ParsePipeline.sha256(Files.readAllBytes(output))))
+                            continue;
+                        for (var screenElement : proof.getAsJsonArray("maps")) {
+                            JsonObject screen = screenElement.getAsJsonObject();
+                            if (!Set.of("OUT", "INOUT").contains(screen.get("mode").getAsString())) continue;
+                            if (index.hosts(screen.get("name").getAsString() + "O").size() != 1) continue;
+                            for (var fieldElement : screen.getAsJsonArray("fields")) {
+                                JsonObject field = fieldElement.getAsJsonObject();
+                                if (field.get("occurs").getAsInt() != 1) continue;
+                                for (String suffix : List.of("A", "C", "H")) {
+                                    if (!suffix.equals("A") && !java.util.stream.StreamSupport.stream(
+                                            screen.getAsJsonArray("extendedAttributes").spliterator(), false)
+                                            .anyMatch(value -> value.getAsString().equals(suffix.equals("C") ? "COLOR" : "HILIGHT")))
+                                        continue;
+                                    String name = field.get("name").getAsString() + suffix;
+                                    Map<String, Object> reference = new LinkedHashMap<>();
+                                    reference.put("name", name);
+                                    reference.put("map", screen.get("name").getAsString());
+                                    reference.put("mapset", screen.get("mapset").getAsString());
+                                    reference.put("field", field.get("name").getAsString());
+                                    reference.put("suffix", suffix);
+                                    reference.put("layoutPath", layout.toString());
+                                    reference.put("layoutSha256", ParsePipeline.sha256(Files.readAllBytes(layout)));
+                                    reference.put("outputPath", output.toString());
+                                    reference.put("outputSha256", proof.get("outputSha256").getAsString());
+                                    fields.computeIfAbsent(name, ignored -> new ArrayList<>()).add(reference);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        } catch (IOException | IllegalArgumentException | IllegalStateException error) {
+            issues.add("platform-contract-bms-layout-invalid:" + error.getMessage());
+        }
+        for (String symbol : symbols().keySet())
+            if (index.hosts(symbol).size() != 1) issues.add("platform-contract-ambiguous-declaration:DFHBMSCA:" + symbol);
+        for (ParseTree node : CicsDependencyAnalysis.nodes(tree)) {
+            if (!(node instanceof TerminalNode terminal)
+                    || !symbols().containsKey(node.getText().toUpperCase(Locale.ROOT))
+                    && !"DFHBMSCA".equalsIgnoreCase(node.getText())
+                    && !fields.containsKey(node.getText().toUpperCase(Locale.ROOT)))
+                continue;
+            if (ancestor(node, "DataDivisionContext") != null) continue;
+            if (ancestor(node, "MoveStatementContext") == null || "DFHBMSCA".equalsIgnoreCase(node.getText()))
+                issues.add("platform-contract-unsupported-use:DFHBMSCA:" + node.getText() + ":" + terminal.getSymbol().getLine());
+        }
+        for (ParseTree node : CicsDependencyAnalysis.nodes(tree)) {
+            if (!(node instanceof ParserRuleContext move) || !node.getClass().getSimpleName().equals("MoveStatementContext"))
+                continue;
+            List<String> tokens = CicsDependencyAnalysis.nodes(move).stream()
+                    .filter(child -> child instanceof TerminalNode).map(ParseTree::getText)
+                    .map(value -> value.startsWith("'") || value.startsWith("\"") ? value : value.toUpperCase(Locale.ROOT)).toList();
+            boolean symbolic = tokens.stream().anyMatch(symbols()::containsKey);
+            boolean destination = tokens.stream().anyMatch(name -> fields.containsKey(name) && index.hosts(name).size() == 1);
+            if (!symbolic && !destination) continue;
+            if (tokens.size() != 4 || !tokens.get(0).equals("MOVE") || !tokens.get(2).equals("TO")
+                    || !fields.containsKey(tokens.get(3)) || fields.get(tokens.get(3)).size() != 1
+                    || index.hosts(tokens.get(3)).size() != 1) {
+                issues.add("platform-contract-unsupported-bms-move:" + move.getStart().getLine());
+                continue;
+            }
+            Map<String, Object> field = fields.get(tokens.get(3)).getFirst();
+            String value = tokens.get(1), suffix = (String) field.get("suffix");
+            boolean supported = symbols().containsKey(value) && symbols().get(value).startsWith(suffix + ":")
+                    || Set.of("'A'", "\"A\"").contains(value) && suffix.equals("A")
+                    || Set.of("HIGH-VALUE", "HIGH-VALUES").contains(value) && Set.of("C", "H").contains(suffix);
+            ParserRuleContext declaration = index.hosts(tokens.get(3)).getFirst();
+            String outputGroup = field.get("map") + "O";
+            boolean inOutput = index.path(declaration).stream().anyMatch(entry ->
+                    CicsDependencyAnalysis.nodes(entry).stream().anyMatch(part ->
+                            part.getClass().getSimpleName().equals("EntryNameContext")
+                                    && part.getText().equalsIgnoreCase(outputGroup)));
+            if (!inOutput && suffix.equals("A")) {
+                String inputGroup = field.get("map") + "I";
+                boolean sharedInput = index.path(declaration).stream().anyMatch(entry ->
+                        CicsDependencyAnalysis.nodes(entry).stream().anyMatch(part ->
+                                part.getClass().getSimpleName().equals("EntryNameContext")
+                                        && part.getText().equalsIgnoreCase(inputGroup)));
+                List<String> groupTokens = CicsDependencyAnalysis.nodes(index.hosts(outputGroup).getFirst())
+                        .stream().filter(part -> part instanceof TerminalNode)
+                        .map(ParseTree::getText).map(token -> token.toUpperCase(Locale.ROOT)).toList();
+                inOutput = sharedInput && groupTokens.contains("REDEFINES") && groupTokens.contains(inputGroup);
+            }
+            if (!supported || !inOutput) {
+                issues.add("platform-contract-unsupported-bms-value:" + value + ":" + move.getStart().getLine());
+                continue;
+            }
+            Map<String, Object> usage = new LinkedHashMap<>();
+            usage.put("grammarRule", "MoveStatementContext");
+            usage.put("sourceText", NodeText.originalText(move, NodeText::PASSTHROUGH));
+            usage.put("syntax", ParsePipeline.dialectSyntax(move));
+            usage.put("line", move.getStart().getLine());
+            usage.put("column", move.getStart().getCharPositionInLine());
+            usage.put("coordinateSpace", "expanded-parser-input");
+            usage.put("fieldBinding", field);
+            usage.put("definitionSyntax", ParsePipeline.dialectSyntax(declaration));
+            usage.put("valueKind", symbols().containsKey(value) ? "named-attribute"
+                    : value.startsWith("'") || value.startsWith("\"") ? "source-character-literal" : "figurative-constant");
+            usages.add(usage);
+        }
+        binding.put("usages", usages);
+        binding.put("bindingStatus", issues.isEmpty() ? "complete" : "unresolved");
+        diagnostics.addAll(issues);
+    }
+
+    private static ParserRuleContext ancestor(ParseTree node, String rule) {
+        for (ParseTree parent = node.getParent(); parent != null; parent = parent.getParent())
+            if (parent.getClass().getSimpleName().equals(rule)) return (ParserRuleContext) parent;
+        return null;
+    }
+}

@@ -0,0 +1,193 @@
+package org.smojol.toolkit.analysis.pipeline;
+
+import org.antlr.v4.runtime.ParserRuleContext;
+import org.antlr.v4.runtime.tree.ParseTree;
+import org.antlr.v4.runtime.tree.TerminalNode;
+import org.eclipse.lsp.cobol.implicitDialects.cics.CICSParser;
+import org.eclipse.lsp.cobol.implicitDialects.sql.Db2SqlParser;
+import org.smojol.common.ast.CallTarget;
+import org.smojol.common.program.StaticCallTarget;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+final class CicsDependencyAnalysis {
+    private record Statement(ParserRuleContext syntax, Map<String, Object> export) {}
+    private final List<Statement> statements = new ArrayList<>();
+    private static final Set<String> INTRINSICS = Set.of("Cics_assignContext", "Cics_abendContext",
+            "Cics_syncpointContext", "Cics_asktimeContext", "Cics_formattimeContext");
+
+    void record(ParserRuleContext context, Map<String, Object> export) {
+        if (INTRINSICS.contains(context.getClass().getSimpleName())
+                || context instanceof CICSParser.Cics_handleContext
+                || context instanceof CICSParser.Cics_linkContext)
+            statements.add(new Statement(context, export));
+    }
+
+    void bind(ParseTree tree, Path directory, List<CallTarget> targets) {
+        CobolDeclarationIndex declarations = new CobolDeclarationIndex(tree);
+        for (Statement statement : statements) {
+            List<String> issues = new ArrayList<>();
+            List<Map<String, Object>> bindings = new ArrayList<>();
+            List<Map<String, String>> references = new ArrayList<>();
+            String rule = statement.syntax().getClass().getSimpleName();
+            if (!declarations.singleProgram()) issues.add("cics-nested-program-scope-unverified");
+            if (statement.syntax() instanceof CICSParser.Cics_handleContext
+                    && (nodes(statement.syntax()).stream().noneMatch(node ->
+                    node.getClass().getSimpleName().equals("Cics_handle_abendContext"))
+                    || nodes(statement.syntax()).stream().noneMatch(node -> node instanceof CICSParser.Cics_labelContext)))
+                issues.add("cics-handle-operation-unsupported");
+            for (ParseTree node : nodes(statement.syntax())) {
+                if (node instanceof CICSParser.VariableNameUsageContext variable
+                        && variable.getChildCount() > 0
+                        && variable.getChild(0) instanceof CICSParser.GeneralIdentifierContext) {
+                    String name = variable.getText().toUpperCase(Locale.ROOT);
+                    if (programOperand(statement.syntax()) != null
+                            && contains(programOperand(statement.syntax()), variable)) continue;
+                    reference("CICS_DATA", name, variable, declarations.hosts(name),
+                            references, bindings, issues);
+                } else if (node instanceof CICSParser.ParagraphNameUsageContext label) {
+                    String name = label.getText().toUpperCase(Locale.ROOT);
+                    reference("CICS_LABEL", name, label, declarations.labels(name),
+                            references, bindings, issues);
+                }
+            }
+            if (statement.syntax() instanceof CICSParser.Cics_linkContext) {
+                try {
+                    bindProgram(statement, tree, declarations, directory, targets, bindings, issues);
+                } catch (IOException | IllegalArgumentException | org.yaml.snakeyaml.error.YAMLException error) {
+                    issues.add("cics-program-binding-invalid:" + error.getMessage());
+                }
+            }
+            statement.export().put("resourceReferences", references);
+            statement.export().put("resourceBindings", bindings);
+            statement.export().put("bindingBasis", INTRINSICS.contains(rule)
+                    ? "parsed-current-task-operation" : "parsed-cics-control-binding");
+            statement.export().put("bindingStatus", issues.isEmpty() ? "complete" : "unresolved");
+            if (!issues.isEmpty()) statement.export().put("bindingDiagnostics", issues.stream().distinct().toList());
+        }
+    }
+
+    private void reference(String kind, String name, ParserRuleContext syntax,
+                           List<ParserRuleContext> candidates, List<Map<String, String>> references,
+                           List<Map<String, Object>> bindings, List<String> issues) {
+        references.add(Map.of("kind", kind, "name", name, "grammarRule", syntax.getClass().getSimpleName()));
+        if (!name.matches("[A-Z][A-Z0-9_-]*") || candidates.size() != 1) {
+            issues.add("cics-declaration-" + (candidates.isEmpty() ? "not-found:" : "ambiguous:") + kind + ":" + name);
+            return;
+        }
+        bindings.add(Map.of("kind", kind, "name", name, "definitionScope", "expanded-parser-input",
+                "definitionSyntax", ParsePipeline.dialectSyntax(candidates.getFirst())));
+    }
+
+    private void bindProgram(Statement statement, ParseTree tree, CobolDeclarationIndex declarations,
+                             Path directory, List<CallTarget> targets,
+                             List<Map<String, Object>> bindings, List<String> issues) throws IOException {
+        CICSParser.Cics_nameContext operand = programOperand(statement.syntax());
+        if (operand == null || nodes(statement.syntax()).stream().anyMatch(node ->
+                node instanceof TerminalNode && Set.of("SYSID", "CHANNEL", "INPUTEVENT", "ACTIVITY")
+                        .contains(node.getText().toUpperCase(Locale.ROOT)))) {
+            issues.add("cics-link-variant-unsupported");
+            return;
+        }
+        String value = operand.name().getText();
+        String name;
+        Map<String, Object> resolution = new LinkedHashMap<>();
+        if (value.matches("(['\"])[A-Za-z0-9@$#_-]{1,8}\\1")) {
+            name = value.substring(1, value.length() - 1);
+            resolution.put("kind", "literal");
+        } else {
+            List<ParserRuleContext> candidates = declarations.hosts(value);
+            if (candidates.size() != 1 || !declarations.singleProgram()) {
+                issues.add("dynamic-cics-program-binding-unresolved:" + value);
+                return;
+            }
+            ParserRuleContext declaration = candidates.getFirst();
+            Matcher constant = Pattern.compile("01" + Pattern.quote(value.toUpperCase(Locale.ROOT))
+                    + "PIC(?:TURE)?(?:IS)?X\\(0*8\\)VALUE(?:IS)?(['\"])([A-Z0-9@$#_-]{1,8})\\1\\.",
+                    Pattern.CASE_INSENSITIVE).matcher(declaration.getText());
+            boolean workingStorage = false;
+            for (ParseTree ancestor = declaration.getParent(); ancestor != null; ancestor = ancestor.getParent())
+                if (ancestor.getClass().getSimpleName().equals("WorkingStorageSectionContext")) workingStorage = true;
+            if (!constant.matches() || !workingStorage || !immutable(tree, value, declaration)) {
+                issues.add("dynamic-cics-program-binding-unresolved:" + value);
+                return;
+            }
+            name = constant.group(2);
+            resolution.put("kind", "immutable-working-storage-literal");
+            resolution.put("operand", value);
+            resolution.put("definitionSyntax", ParsePipeline.dialectSyntax(declaration));
+            resolution.put("usageProof", "single-native-program:all-symbol-references-are-cics-program-operands");
+        }
+        Map<String, Object> binding = CicsResourceCatalog.program(name).orElse(null);
+        if (binding == null) {
+            issues.add("cics-program-definition-not-found:" + name);
+            return;
+        }
+        List<Path> sources;
+        try (var files = Files.walk(directory)) {
+            sources = files.filter(Files::isRegularFile).filter(path ->
+                    path.getFileName().toString().equalsIgnoreCase(name + ".cbl")
+                            || path.getFileName().toString().equalsIgnoreCase(name + ".cob")).toList();
+        }
+        if (sources.size() != 1) {
+            issues.add("cics-program-source-" + (sources.isEmpty() ? "not-found:" : "ambiguous:") + name);
+            return;
+        }
+        binding.put("programSourcePath", sources.getFirst().toRealPath().toString());
+        binding.put("programSourceSha256", ParsePipeline.sha256(Files.readAllBytes(sources.getFirst())));
+        binding.put("targetResolution", resolution);
+        bindings.add(binding);
+        targets.add(new StaticCallTarget(name));
+    }
+
+    private boolean immutable(ParseTree tree, String name, ParserRuleContext declaration) {
+        List<ParseTree> allowed = statements.stream().map(statement -> programOperand(statement.syntax()))
+                .filter(java.util.Objects::nonNull).map(node -> (ParseTree) node).toList();
+        for (ParseTree node : nodes(tree)) {
+            if (node instanceof TerminalNode && "ADDRESS".equalsIgnoreCase(node.getText())) return false;
+            if (node instanceof TerminalNode && name.equalsIgnoreCase(node.getText())
+                    && !contains(declaration, node) && allowed.stream().noneMatch(root -> contains(root, node)))
+                return false;
+            if (node instanceof Db2SqlParser.SqlCodeContext sql
+                    && sql.getCustomData().get("REKT_SQL_SEMANTIC_TREE") instanceof ParseTree semantic
+                    && nodes(semantic).stream().anyMatch(reference ->
+                    reference.getClass().getSimpleName().startsWith("Dbs_host_")
+                            && name.equalsIgnoreCase(reference.getText().replaceFirst("^:", "")))) return false;
+        }
+        return true;
+    }
+
+    private static CICSParser.Cics_nameContext programOperand(ParseTree tree) {
+        for (ParseTree node : nodes(tree)) {
+            if (!node.getClass().getSimpleName().equals("Cics_link_programContext")) continue;
+            for (int index = 1; index < node.getChildCount(); index++)
+                if ("PROGRAM".equalsIgnoreCase(node.getChild(index - 1).getText())
+                        && node.getChild(index) instanceof CICSParser.Cics_nameContext operand)
+                    return operand;
+        }
+        return null;
+    }
+
+    private static boolean contains(ParseTree root, ParseTree node) {
+        for (ParseTree ancestor = node; ancestor != null; ancestor = ancestor.getParent())
+            if (ancestor == root) return true;
+        return false;
+    }
+
+    private static List<ParseTree> nodes(ParseTree root) {
+        List<ParseTree> result = new ArrayList<>();
+        result.add(root);
+        for (int index = 0; index < root.getChildCount(); index++) result.addAll(nodes(root.getChild(index)));
+        return result;
+    }
+}

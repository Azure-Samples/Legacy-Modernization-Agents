@@ -0,0 +1,53 @@
+package org.smojol.toolkit.analysis.pipeline;
+
+import org.antlr.v4.runtime.ParserRuleContext;
+import org.antlr.v4.runtime.tree.ParseTree;
+import org.eclipse.lsp.cobol.core.CobolParser;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+final class CobolDeclarationIndex {
+    private final Map<String, List<ParserRuleContext>> hosts = new LinkedHashMap<>();
+    private final Map<String, List<ParserRuleContext>> labels = new LinkedHashMap<>();
+    private int programs;
+
+    CobolDeclarationIndex(ParseTree tree) {
+        collect(tree);
+    }
+
+    boolean singleProgram() {
+        return programs == 1;
+    }
+
+    List<ParserRuleContext> hosts(String name) {
+        return hosts.getOrDefault(name.toUpperCase(Locale.ROOT), List.of());
+    }
+
+    List<ParserRuleContext> labels(String name) {
+        return labels.getOrDefault(name.toUpperCase(Locale.ROOT), List.of());
+    }
+
+    private void collect(ParseTree node) {
+        if (node instanceof CobolParser.ProgramUnitContext) programs++;
+        if (node instanceof CobolParser.DataDescriptionEntryFormat1Context entry && entry.entryName() != null)
+            host(entry.entryName().getText(), entry);
+        else if (node instanceof CobolParser.DataDescriptionEntryFormat1Level77Context entry && entry.entryName() != null)
+            host(entry.entryName().getText(), entry);
+        if (node instanceof CobolParser.ParagraphDefinitionNameContext
+                || node instanceof CobolParser.SectionNameContext
+                && node.getParent() instanceof CobolParser.ProcedureSectionHeaderContext) {
+            ParserRuleContext label = (ParserRuleContext) node;
+            labels.computeIfAbsent(label.getText().toUpperCase(Locale.ROOT), ignored -> new ArrayList<>()).add(label);
+        }
+        for (int index = 0; index < node.getChildCount(); index++) collect(node.getChild(index));
+    }
+
+    private void host(String name, ParserRuleContext declaration) {
+        if (!"FILLER".equalsIgnoreCase(name))
+            hosts.computeIfAbsent(name.toUpperCase(Locale.ROOT), ignored -> new ArrayList<>()).add(declaration);
+    }
+}

+    // EVALUATE EIBAID with WHEN <named event> phrases only: each WHEN is an equality of the
+    // subject with one named event. ALSO, THRU, ANY, NOT and application values stay blocked.
+    private static void evaluateEvents(CobolParser.EvaluateStatementContext evaluate, Set<ParseTree> visited,
+                                       List<Map<String, Object>> usages, List<String> diagnostics) {
+        List<String> subject = new ArrayList<>();
+        tokens(evaluate.evaluateSelect(), subject);
+        boolean valid = subject.equals(List.of("EIBAID")) && evaluate.evaluateAlsoSelect().isEmpty();
+        List<Map<String, Object>> found = new ArrayList<>();
+        List<ParseTree> bound = new ArrayList<>(List.of(evaluate.evaluateSelect()));
+        Map<String, Object> subjectUsage = new LinkedHashMap<>();
+        subjectUsage.put("grammarRule", "EvaluateSelectContext");
+        subjectUsage.put("conditionRole", "evaluate-subject");
+        subjectUsage.put("sourceText", NodeText.originalText(evaluate.evaluateSelect(), NodeText::PASSTHROUGH));
+        subjectUsage.put("syntax", ParsePipeline.dialectSyntax(evaluate.evaluateSelect()));
+        subjectUsage.put("line", evaluate.evaluateSelect().getStart().getLine());
+        subjectUsage.put("column", evaluate.evaluateSelect().getStart().getCharPositionInLine());
+        subjectUsage.put("coordinateSpace", "expanded-parser-input");
+        found.add(subjectUsage);
+        for (CobolParser.EvaluateWhenPhraseContext phrase : evaluate.evaluateWhenPhrase()) {
+            for (CobolParser.EvaluateWhenContext when : phrase.evaluateWhen()) {
+                List<String> parts = new ArrayList<>();
+                tokens(when.evaluateCondition(), parts);
+                if (!when.evaluateAlsoCondition().isEmpty() || parts.size() != 1
+                        || !symbols().containsKey(parts.getFirst())) {
+                    valid = false;
+                    continue;
+                }
+                Map<String, Object> usage = new LinkedHashMap<>();
+                usage.put("grammarRule", "EvaluateWhenContext");
+                usage.put("conditionRole", "evaluate-when");
+                usage.put("sourceText", NodeText.originalText(when, NodeText::PASSTHROUGH));
+                usage.put("syntax", ParsePipeline.dialectSyntax(when));
+                usage.put("line", when.getStart().getLine());
+                usage.put("column", when.getStart().getCharPositionInLine());
+                usage.put("coordinateSpace", "expanded-parser-input");
+                found.add(usage);
+                bound.add(when.evaluateCondition());
+            }
+        }
+        if (!valid || found.size() < 2) {
+            diagnostics.add("platform-contract-unsupported-evaluate:DFHAID:" + evaluate.getStart().getLine());
+            return;
+        }
+        usages.addAll(found);
+        for (ParseTree tree : bound) markVisited(tree, visited);
+    }
+
+    private static void markVisited(ParseTree node, Set<ParseTree> visited) {
+        visited.add(node);
+        for (int i = 0; i < node.getChildCount(); i++) markVisited(node.getChild(i), visited);
+    }

+++ b/smojol-toolkit/src/main/java/org/smojol/toolkit/analysis/pipeline/DependencyAnalysisProfile.java
@@ -0,0 +1,97 @@
+package org.smojol.toolkit.analysis.pipeline;
+
+import com.google.common.hash.Hashing;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public final class DependencyAnalysisProfile {
+    private final Map<?, ?> document;
+    private final String path;
+    private final String hash;
+
+    private DependencyAnalysisProfile(Map<?, ?> document, String path, String hash) {
+        this.document = document;
+        this.path = path;
+        this.hash = hash;
+    }
+
+    public static DependencyAnalysisProfile load() {
+        String configured = System.getenv("REKT_DEPENDENCY_PROFILE");
+        if (configured == null || configured.isBlank())
+            return new DependencyAnalysisProfile(Map.of(), null, null);
+        try {
+            Path path = Path.of(configured).toRealPath();
+            byte[] bytes = Files.readAllBytes(path);
+            LoaderOptions options = new LoaderOptions();
+            options.setAllowDuplicateKeys(false);
+            options.setMaxAliasesForCollections(0);
+            options.setCodePointLimit(1024 * 1024);
+            Object loaded = new Yaml(new SafeConstructor(options)).load(new String(bytes, StandardCharsets.UTF_8));
+            if (!(loaded instanceof Map<?, ?> document)
+                    || !Integer.valueOf(1).equals(document.get("schemaVersion"))
+                    || !"target-port".equals(document.get("profileKind"))
+                    || !(document.get("profileName") instanceof String name) || name.isBlank()
+                    || !Set.of("schemaVersion", "profileName", "profileKind", "sqlDefaultSchema", "runtimeContracts")
+                        .containsAll(document.keySet()))
+                throw new IllegalArgumentException("Invalid dependency profile identity/schema: " + path);
+            Object schema = document.get("sqlDefaultSchema");
+            if (schema != null && (!(schema instanceof String value) || !value.matches("[A-Z][A-Z0-9_]*")))
+                throw new IllegalArgumentException("Unsupported configured SQL schema: " + schema);
+            if (!(document.get("runtimeContracts") instanceof Map<?, ?> contracts))
+                throw new IllegalArgumentException("runtimeContracts must be an explicit object");
+            for (Map.Entry<?, ?> entry : contracts.entrySet()) {
+                int count = "CEEGMT".equals(entry.getKey()) ? 3 : "CEEDATM".equals(entry.getKey()) ? 4 : -1;
+                String topic = "CEEGMT".equals(entry.getKey())
+                        ? "ceegmtget-current-greenwich-mean-time" : "ceedatmconvert-seconds-character-timestamp";
+                if (count < 0 || !(entry.getValue() instanceof Map<?, ?> contract)
+                        || !"documented-platform-service".equals(contract.get("kind"))
+                        || !"IBM z/OS Language Environment".equals(contract.get("platform"))
+                        || !(contract.get("parameters") instanceof List<?> parameters) || parameters.size() != count
+                        || !(contract.get("documentation") instanceof List<?> references)
+                        || !references.contains("https://www.ibm.com/docs/en/zos/3.1.0?topic=services-" + topic)
+                        || !(contract.get("semantics") instanceof Map<?, ?>))
+                    throw new IllegalArgumentException("Unsupported or incomplete documented runtime contract: " + entry.getKey());
+            }
+            return new DependencyAnalysisProfile(document, path.toString(), Hashing.sha256().hashBytes(bytes).toString());
+        } catch (IOException exception) {
+            throw new UncheckedIOException("Cannot read configured dependency profile: " + configured, exception);
+        }
+    }
+
+    public String defaultSchema() {
+        return (String) document.get("sqlDefaultSchema");
+    }
+
+    private Map<String, Object> provenance() {
+        return new LinkedHashMap<>(Map.of("profileName", document.get("profileName"),
+                "profileKind", document.get("profileKind"), "sourcePath", path, "sourceSha256", hash));
+    }
+
+    public Map<String, Object> qualification() {
+        Map<String, Object> result = provenance();
+        result.put("schema", defaultSchema());
+        return result;
+    }
+
+    public Map<String, Object> runtimeContract(String name) {
+        Object configured = document.get("runtimeContracts");
+        if (!(configured instanceof Map<?, ?> contracts) || !contracts.containsKey(name)) return null;
+        Map<String, Object> result = provenance();
+        result.put("name", name);
+        result.put("definition", contracts.get(name));
+        result.put("runtimeMapping", "unverified");
+        result.put("resolutionKind", "documented-platform-contract");
+        return result;
+    }
+}

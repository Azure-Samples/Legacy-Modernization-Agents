+package org.smojol.toolkit.analysis.pipeline;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+/**
+ * Byte layout of a program-declared {@code 01 FILLER REDEFINES <map>I|O} overlay. Only DISPLAY X fields,
+ * binary halfwords, plain groups, group REDEFINES of a named earlier sibling and one group OCCURS are
+ * accepted; anything else yields no layout.
+ */
+final class BmsOverlayLayout {
+    private static final Pattern LEVEL = Pattern.compile("0?[1-9]|[1-4][0-9]");
+    private static final Pattern NAME = Pattern.compile("[A-Z][A-Z0-9-]*");
+    private static final Pattern DISPLAY = Pattern.compile("PIC(?:TURE)?(?:IS)?X(?:\\(0*([1-9][0-9]{0,3})\\))?\\.");
+    private static final Pattern HALFWORD = Pattern.compile(
+            "(?:PIC(?:TURE)?(?:IS)?S9\\(0*4\\)(?:COMP|COMPUTATIONAL|BINARY|COMP-4|COMPUTATIONAL-4)"
+                    + "|(?:COMP|COMPUTATIONAL|BINARY|COMP-4|COMPUTATIONAL-4)PIC(?:TURE)?(?:IS)?S9\\(0*4\\))\\.");
+    private static final Pattern OCCURS = Pattern.compile("OCCURS0*([1-9][0-9]{0,3})(?:TIMES)?\\.");
+
+    record Located(String redefined, int base, int stride, int count) { }
+
+    private static final class Entry {
+        int level;
+        String name;
+        String redefines;
+        int occurs = 1;
+        int size = -1;
+        int offset;
+        Entry parent;
+        final List<Entry> children = new ArrayList<>();
+    }
+
+    static Located locate(List<String> record, List<List<String>> members, int target) {
+        List<String> head = upper(record);
+        if (head.size() != 5 || !head.get(0).matches("0?1") || !head.get(1).equals("FILLER")
+                || !head.get(2).equals("REDEFINES") || !NAME.matcher(head.get(3)).matches() || !head.get(4).equals("."))
+            return null;
+        if (target < 0 || target >= members.size()) return null;
+        Entry root = new Entry();
+        root.level = 1;
+        root.name = "FILLER";
+        List<Entry> entries = new ArrayList<>();
+        Entry open = root;
+        for (List<String> member : members) {
+            Entry entry = parse(upper(member));
+            if (entry == null || entry.level <= 1) return null;
+            while (open != root && open.level >= entry.level) open = open.parent;
+            if (open.size >= 0) return null;
+            entry.parent = open;
+            open.children.add(entry);
+            entries.add(entry);
+            if (entry.size < 0) open = entry;
+        }
+        if (size(root) < 0 || !place(root, 0)) return null;
+        Entry field = entries.get(target);
+        if (field.size != 1 || field.name.equals("FILLER")
+                || entries.stream().filter(entry -> entry.name.equals(field.name)).count() != 1) return null;
+        Entry table = null;
+        for (Entry ancestor = field.parent; ancestor != null; ancestor = ancestor.parent)
+            if (ancestor.occurs > 1) {
+                if (table != null) return null;
+                table = ancestor;
+            }
+        if (table == null) return null;
+        return new Located(head.get(3), field.offset, size(table) / table.occurs, table.occurs);
+    }
+
+    private static Entry parse(List<String> tokens) {
+        if (tokens.size() < 3 || !LEVEL.matcher(tokens.get(0)).matches() || !NAME.matcher(tokens.get(1)).matches()
+                || tokens.get(1).equals("REDEFINES") || tokens.get(1).equals("OCCURS")) return null;
+        Entry entry = new Entry();
+        entry.level = Integer.parseInt(tokens.get(0));
+        entry.name = tokens.get(1);
+        List<String> rest = tokens.subList(2, tokens.size());
+        String clause = String.join("", rest);
+        if (rest.size() == 1 && clause.equals(".")) return entry;
+        if (rest.size() == 3 && rest.get(0).equals("REDEFINES") && NAME.matcher(rest.get(1)).matches() && rest.get(2).equals(".")) {
+            entry.redefines = rest.get(1);
+            return entry;
+        }
+        var occurs = OCCURS.matcher(clause);
+        if (rest.getFirst().equals("OCCURS") && occurs.matches()) {
+            entry.occurs = Integer.parseInt(occurs.group(1));
+            return entry;
+        }
+        var display = DISPLAY.matcher(clause);
+        if (display.matches()) {
+            entry.size = display.group(1) == null ? 1 : Integer.parseInt(display.group(1));
+            return entry;
+        }
+        if (HALFWORD.matcher(clause).matches()) {
+            entry.size = 2;
+            return entry;
+        }
+        return null;
+    }
+
+    private static int size(Entry entry) {
+        if (entry.children.isEmpty()) return entry.size;
+        int total = 0;
+        for (Entry child : entry.children) {
+            int width = size(child);
+            if (width <= 0) return -1;
+            if (child.redefines == null) total += width;
+        }
+        return total * entry.occurs;
+    }
+
+    private static boolean place(Entry group, int start) {
+        int cursor = start;
+        for (int index = 0; index < group.children.size(); index++) {
+            Entry child = group.children.get(index);
+            if (child.redefines != null) {
+                if (child.occurs != 1) return false;
+                Entry base = null;
+                for (Entry sibling : group.children.subList(0, index))
+                    if (sibling.redefines == null && sibling.name.equals(child.redefines)) base = sibling;
+                if (base == null || base.occurs != 1 || size(child) > size(base)) return false;
+                child.offset = base.offset;
+            } else {
+                child.offset = cursor;
+                cursor += size(child);
+            }
+            if (!child.children.isEmpty() && !place(child, child.offset)) return false;
+        }
+        return true;
+    }
+
+    // FIL-Rnnn is the preprocessor's layout-neutral rename of FILLER REDEFINES.
+    private static List<String> upper(List<String> tokens) {
+        return tokens.stream().map(token -> token.toUpperCase(Locale.ROOT))
+                .map(token -> token.matches("FIL-R[0-9]+") ? "FILLER" : token).toList();
+    }
+}

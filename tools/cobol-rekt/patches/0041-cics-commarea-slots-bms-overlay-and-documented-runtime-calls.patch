+package org.smojol.toolkit.analysis.pipeline;
+
+import org.antlr.v4.runtime.ParserRuleContext;
+import org.antlr.v4.runtime.tree.ParseTree;
+import org.antlr.v4.runtime.tree.TerminalNode;
+import org.eclipse.lsp.cobol.core.CobolParser;
+import org.eclipse.lsp.cobol.implicitDialects.cics.CICSParser;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import static org.smojol.toolkit.analysis.pipeline.CicsDependencyAnalysis.nodes;
+
+/*
+ * Per-program COMMAREA facts for the estate closure: every 01-level record that is sent as a COMMAREA, loaded
+ * from DFHCOMMAREA or copied into a carrier, with its slot write inventory; every carrier (01-level PIC X item
+ * that is sent and only ever holds one record followed by data written at LENGTH OF record + 1); and every
+ * XCTL/RETURN/LINK COMMAREA send. Sends of anything else are "foreign"; foreign and LINK record sends carry their resolved program targets.
+ */
+final class CicsCommareaInventory {
+    final Map<ParserRuleContext, CicsSlotUniverse> records = new LinkedHashMap<>();
+    final List<Map<String, Object>> carriers = new ArrayList<>();
+    final List<Map<String, Object>> sends = new ArrayList<>();
+    final Map<Map<String, Object>, ParserRuleContext> foreign = new LinkedHashMap<>();
+    private final ParseTree tree;
+    private final CobolDeclarationIndex declarations;
+    private final List<ParseTree> readOnly;
+
+    private CicsCommareaInventory(ParseTree tree, CobolDeclarationIndex declarations, List<ParseTree> readOnly) {
+        this.tree = tree;
+        this.declarations = declarations;
+        this.readOnly = readOnly;
+    }
+
+    static CicsCommareaInventory build(ParseTree tree, CobolDeclarationIndex declarations, List<ParseTree> readOnly,
+                                       List<ParserRuleContext> commands) {
+        CicsCommareaInventory inventory = new CicsCommareaInventory(tree, declarations, readOnly);
+        Map<ParserRuleContext, Map<String, Object>> carrierFacts = new LinkedHashMap<>();
+        for (ParserRuleContext command : commands) {
+            String operation = command instanceof CICSParser.Cics_xctlContext ? "XCTL"
+                    : command instanceof CICSParser.Cics_returnContext ? "RETURN"
+                    : command instanceof CICSParser.Cics_linkContext ? "LINK" : null;
+            if (operation == null) continue;
+            for (ParseTree operand : CicsTerminalBindings.operands(command, "COMMAREA")) {
+                Map<String, Object> send = new LinkedHashMap<>();
+                send.put("command", operation);
+                send.put("operand", operand.getText().replaceAll("^\\(|\\)$", "").toUpperCase(Locale.ROOT));
+                send.put("line", command.getStart().getLine());
+                send.put("column", command.getStart().getCharPositionInLine());
+                ParserRuleContext declaration = inventory.plainDeclaration(operand);
+                ParserRuleContext record = declaration == null ? null
+                        : CicsSlotUniverse.recordOf(declarations, declaration);
+                if (record != null && record == declaration && !declarations.children(record).isEmpty()) {
+                    send.put("kind", "record");
+                    send.put("record", CicsConstantResolution.entryName(record));
+                    inventory.records.putIfAbsent(record, null);
+                    if ("LINK".equals(operation)) inventory.foreign.put(send, command);
+                } else if (record != null && record == declaration && !"LINK".equals(operation)) {
+                    send.put("kind", "carrier");
+                    send.put("carrier", CicsConstantResolution.entryName(record));
+                    carrierFacts.putIfAbsent(record, null);
+                } else {
+                    send.put("kind", "foreign");
+                    inventory.foreign.put(send, command);
+                }
+                inventory.sends.add(send);
+            }
+        }
+        for (ParseTree node : nodes(tree)) {
+            if (!(node instanceof CobolParser.MoveStatementContext move) || move.moveToStatement() == null
+                    || move.moveToStatement().generalIdentifier().size() != 1) continue;
+            if (!move.moveToStatement().moveToSendingArea().getText().toUpperCase(Locale.ROOT)
+                    .startsWith("DFHCOMMAREA(1:")) continue;
+            ParserRuleContext declaration = inventory.plainDeclaration(move.moveToStatement().generalIdentifier(0));
+            ParserRuleContext record = declaration == null ? null : CicsSlotUniverse.recordOf(declarations, declaration);
+            if (record != null && record == declaration && !declarations.children(record).isEmpty())
+                inventory.records.putIfAbsent(record, null);
+        }
+        for (ParserRuleContext carrier : new ArrayList<>(carrierFacts.keySet())) {
+            Map<String, Object> fact = inventory.carrier(carrier);
+            carrierFacts.put(carrier, fact);
+            inventory.carriers.add(fact);
+        }
+        for (ParserRuleContext record : new ArrayList<>(inventory.records.keySet()))
+            inventory.records.put(record, CicsSlotUniverse.analyse(tree, declarations, readOnly, record));
+        return inventory;
+    }
+
+    private ParserRuleContext plainDeclaration(ParseTree operand) {
+        String text = operand.getText().replaceAll("^\\((.*)\\)$", "$1");
+        if (!text.matches("[A-Za-z][A-Za-z0-9-]*")) return null;
+        List<ParserRuleContext> hosts = declarations.hosts(text);
+        return hosts.size() == 1 ? hosts.getFirst() : null;
+    }
+

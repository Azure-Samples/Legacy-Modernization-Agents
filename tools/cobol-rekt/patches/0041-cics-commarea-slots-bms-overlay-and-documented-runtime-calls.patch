+package org.smojol.toolkit.analysis.pipeline;
+
+import org.antlr.v4.runtime.ParserRuleContext;
+import org.antlr.v4.runtime.tree.ParseTree;
+import org.antlr.v4.runtime.tree.TerminalNode;
+import org.eclipse.lsp.cobol.core.CobolParser;
+import org.eclipse.lsp.cobol.implicitDialects.cics.CICSParser;
+import org.eclipse.lsp.cobol.implicitDialects.sql.Db2SqlParser;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import static org.smojol.toolkit.analysis.pipeline.CicsConstantResolution.contains;
+import static org.smojol.toolkit.analysis.pipeline.CicsDependencyAnalysis.nodes;
+
+/*
+ * Flow-insensitive write inventory of one 01-level WORKING/LOCAL-STORAGE record. Every procedure reference to the
+ * record or a subordinate name is classified; for each elementary PIC X(1..8) slot the result is the set of all
+ * values the slot can ever hold: its initial VALUE, MOVE literal / proved constant / SPACES / LOW-VALUES,
+ * INITIALIZE, a copy of a sibling slot (MOVE sibling TO slot) and, when the whole record is loaded with
+ * MOVE DFHCOMMAREA(1:EIBCALEN | 1:LENGTH OF record) TO record, the incoming COMMAREA value ("entry").
+ * Any other write reaching a slot (subscripted or reference-modified receivers, group moves, CALL USING, CICS
+ * INTO/SET, SQL host use, ADDRESS OF, REDEFINES/RENAMES aliasing, LINK COMMAREA) makes that slot unsupported.
+ * Control flow is irrelevant: the union covers every path, so GO TO, HANDLE CONDITION and the like are allowed.
+ */
+final class CicsSlotUniverse {
+    static final String LOCAL_PROOF = "single-native-program:flow-insensitive-slot-writes";
+    static final String CLOSURE_PROOF = "estate-closed-world:flow-insensitive-commarea-slot-closure";
+    private static final Pattern SLOT = Pattern.compile(
+            "(0?[2-9]|[1-4][0-9])([A-Z0-9-]+)PIC(?:TURE)?(?:IS)?(?:X\\(0*([1-8])\\)|(X{1,8}))"
+                    + "(?:VALUE(?:IS)?(?:(['\"])([^'\"]*)\\5|(SPACES?|LOW-VALUES?)))?\\.", Pattern.CASE_INSENSITIVE);
+
+    static final class Slot {
+        final ParserRuleContext definition;
+        final String name;
+        final int length;
+        final List<String> values = new ArrayList<>();
+        final LinkedHashSet<String> copies = new LinkedHashSet<>();
+        final List<String> unsupported = new ArrayList<>();
+        final List<Map<String, Object>> writes = new ArrayList<>();
+        boolean entry;
+
+        Slot(ParserRuleContext definition, String name, int length) {
+            this.definition = definition;
+            this.name = name;
+            this.length = length;
+        }
+
+        void value(String value) {
+            if (!values.contains(value)) values.add(value);
+        }
+    }
+
+    final ParserRuleContext record;
+    final String name;
+    final Map<String, Slot> slots = new LinkedHashMap<>();
+    final List<String> issues = new ArrayList<>();
+    final List<ParserRuleContext> entries = new ArrayList<>();
+    boolean loaded;
+    private final Set<String> names = new LinkedHashSet<>();
+    private final Map<String, ParserRuleContext> conditions = new LinkedHashMap<>();
+    private final ParseTree tree;
+    private final CobolDeclarationIndex declarations;
+    private final List<ParseTree> readOnly;
+
+    private CicsSlotUniverse(ParseTree tree, CobolDeclarationIndex declarations, List<ParseTree> readOnly,
+                             ParserRuleContext record) {
+        this.tree = tree;
+        this.declarations = declarations;
+        this.readOnly = readOnly;
+        this.record = record;
+        this.name = CicsConstantResolution.entryName(record);
+    }
+
+    /* The enclosing 01-level record of a declaration, or null when it is not a WORKING/LOCAL-STORAGE record. */
+    static ParserRuleContext recordOf(CobolDeclarationIndex declarations, ParserRuleContext declaration) {
+        List<ParserRuleContext> path = declarations.path(declaration);
+        if (path.isEmpty() || CicsConstantResolution.storageSection(declaration) == null) return null;
+        ParserRuleContext root = path.getFirst();
+        return root instanceof CobolParser.DataDescriptionEntryFormat1Context
+                && root.getStart().getText().matches("0?1") ? root : null;
+    }
+
+    static CicsSlotUniverse analyse(ParseTree tree, CobolDeclarationIndex declarations, List<ParseTree> readOnly,
+                                    ParserRuleContext record) {
+        CicsSlotUniverse universe = new CicsSlotUniverse(tree, declarations, readOnly, record);
+        universe.collect();
+        return universe;
+    }
+
+    private boolean inside(ParserRuleContext entry) {
+        List<ParserRuleContext> path = declarations.path(entry);
+        return !path.isEmpty() && path.getFirst() == record;
+    }
+
+    private List<Slot> under(ParserRuleContext entry) {
+        return slots.values().stream().filter(slot -> declarations.path(slot.definition).contains(entry)).toList();
+    }
+
+    private void unsupported(List<Slot> affected, String reason) {
+        for (Slot slot : affected) if (!slot.unsupported.contains(reason)) slot.unsupported.add(reason);
+    }
+
+    private void collect() {
+        if (!declarations.singleProgram()) issues.add("nested-program-scope");
+        ParserRuleContext owner = null;
+        for (ParseTree node : nodes(tree)) {
+            if (node instanceof CobolParser.DataDescriptionEntryFormat1Context
+                    || node instanceof CobolParser.DataDescriptionEntryFormat1Level77Context) {
+                owner = (ParserRuleContext) node;
+                if (inside(owner)) {
+                    entries.add(owner);
+                    String entry = CicsConstantResolution.entryName(owner);
+                    if (!"FILLER".equals(entry)) names.add(entry);
+                }
+            }
+            if (node instanceof CobolParser.DataDescriptionEntryFormat3Context condition && owner != null
+                    && inside(owner) && condition.getChildCount() > 1)
+                conditions.put(condition.getChild(1).getText().toUpperCase(Locale.ROOT), owner);
+        }
+        for (ParserRuleContext entry : entries) {
+            if (!declarations.children(entry).isEmpty()) continue;
+            Matcher shape = SLOT.matcher(entry.getText());
+            if (!shape.matches() || !shape.group(2).equalsIgnoreCase(CicsConstantResolution.entryName(entry))) continue;
+            int length = shape.group(3) != null ? Integer.parseInt(shape.group(3)) : shape.group(4).length();
+            Slot slot = new Slot(entry, shape.group(2).toUpperCase(Locale.ROOT), length);
+            String initial = shape.group(6) == null ? null : shape.group(6).replaceFirst(" +$", "");
+            if (initial != null && initial.length() > length) slot.unsupported.add("initial-value-truncated");
+            slot.value(initial == null || initial.isEmpty() ? null : initial);
+            slots.putIfAbsent(slot.name, slot);
+        }
+        for (ParseTree node : nodes(tree)) {
+            if (node instanceof CobolParser.DataRedefinesClauseContext redefines) {
+                String subject = redefines.getText().replaceFirst("(?i)^REDEFINES", "").toUpperCase(Locale.ROOT);
+                ParserRuleContext alias = null;
+                for (ParseTree up = redefines.getParent(); up != null && alias == null; up = up.getParent())
+                    if (up instanceof CobolParser.DataDescriptionEntryFormat1Context entry) alias = entry;
+                if (subject.equals(CicsConstantResolution.entryName(record))) issues.add("redefined");
+                else if (alias != null && inside(alias)) {
+                    // Storage shared by the redefined and redefining items: only those slots lose their write inventory.
+                    unsupported(under(alias), "redefined");
+                    for (ParserRuleContext redefined : named(subject)) unsupported(under(redefined), "redefined");
+                    if (named(subject).isEmpty()) issues.add("redefined");
+                } else if (names.contains(subject)) issues.add("redefined");
+            }
+            if (node instanceof CobolParser.DataDescriptionEntryFormat2Context renames
+                    && names.stream().anyMatch(item -> renames.getText().toUpperCase(Locale.ROOT).contains(item)))
+                issues.add("renamed");
+            if (node instanceof Db2SqlParser.SqlCodeContext sql
+                    && sql.getCustomData().get("REKT_SQL_SEMANTIC_TREE") instanceof ParseTree semantic
+                    && nodes(semantic).stream().anyMatch(reference ->
+                    reference.getClass().getSimpleName().startsWith("Dbs_host_")
+                            && names.contains(reference.getText().replaceFirst("^:", "").toUpperCase(Locale.ROOT))))
+                issues.add("sql-host-variable");
+            if (!(node instanceof TerminalNode) || within(node, CobolParser.DataDivisionContext.class)) continue;
+            String token = node.getText().toUpperCase(Locale.ROOT);
+            if ("ADDRESS".equals(token) && node.getParent() != null && names.stream().anyMatch(item ->
+                    node.getParent().getText().toUpperCase(Locale.ROOT).startsWith("ADDRESSOF" + item)))
+                issues.add("address-of");
+            if (conditions.containsKey(token)) {
+                if (CicsConstantResolution.readPosition(node) || within(node, CobolParser.EvaluateSelectContext.class)
+                        || within(node, CobolParser.EvaluateConditionContext.class)) continue;
+                ParserRuleContext parent = conditions.get(token);
+                unsupported(slots.values().stream().filter(slot -> slot.definition == parent).toList(),
+                        "condition-name-write");
+                continue;
+            }
+            if (names.contains(token)) reference(node, token);
+        }
+        List<String> distinct = new ArrayList<>(new LinkedHashSet<>(issues));
+        issues.clear();
+        issues.addAll(distinct);
+    }
+
+    private List<ParserRuleContext> named(String token) {
+        return declarations.hosts(token).stream().filter(this::inside).toList();
+    }
+
+    private void reference(ParseTree node, String token) {
+        ParserRuleContext command = cicsCommand(node);
+        if (command != null) {
+            boolean transfer = command instanceof CICSParser.Cics_xctlContext
+                    || command instanceof CICSParser.Cics_returnContext;
+            if (transfer && (operandContains(command, "COMMAREA", node) || operandContains(command, "LENGTH", node)
+                    || operandContains(command, "PROGRAM", node)))
+                return;
+            if (command instanceof CICSParser.Cics_linkContext) {
+                if (operandContains(command, "PROGRAM", node) || operandContains(command, "LENGTH", node)
+                        || operandContains(command, "DATALENGTH", node)) return;
+                if (operandContains(command, "COMMAREA", node)) {
+                    issues.add("linked-commarea");
+                    return;
+                }
+            }
+            unsupported(named(token).stream().flatMap(entry -> under(entry).stream()).toList(),
+                    "cics-" + command.getClass().getSimpleName());
+            return;
+        }
+        if (within(node, CobolParser.InDataContext.class) || lengthOnly(node)) return;
+        if (CicsConstantResolution.readPosition(node) || within(node, CobolParser.EvaluateSelectContext.class)
+                || within(node, CobolParser.EvaluateConditionContext.class)) return;
+        ParserRuleContext statement = null;
+        for (ParseTree up = node; up != null; up = up.getParent())
+            if (up.getParent() instanceof CobolParser.StatementContext) {
+                statement = (ParserRuleContext) up;
+                break;
+            }
+        CobolParser.GeneralIdentifierContext identifier = ancestor(node, CobolParser.GeneralIdentifierContext.class);
+        CobolParser.QualifiedDataNameContext qualified = identifier == null ? null : identifier.qualifiedDataName();
+        List<ParserRuleContext> targets;
+        if (qualified == null || qualified.variableUsageName() == null) {
+            targets = named(token);
+        } else {
+            List<String> path = new ArrayList<>();
+            path.add(qualified.variableUsageName().getText().toUpperCase(Locale.ROOT));
+            for (CobolParser.InDataContext in : qualified.inData())
+                path.add(in.variableUsageName().getText().toUpperCase(Locale.ROOT));
+            targets = declarations.hosts(path).stream().filter(this::inside).toList();
+            if (targets.isEmpty() && declarations.hosts(path).size() > 0) return;
+            if (targets.isEmpty()) targets = named(token);
+        }
+        List<Slot> affected = targets.stream().flatMap(entry -> under(entry).stream()).distinct().toList();
+        if (statement == null) {
+            issues.add("unstructured-reference:" + token);
+            return;
+        }
+        boolean plain = qualified != null && qualified.tableCall() == null && qualified.referenceModifier() == null
+                && qualified.inData().stream().allMatch(in -> in.tableCall() == null && in.referenceModifier() == null)
+                && targets.size() == 1;
+        if (statement instanceof CobolParser.MoveStatementContext move && move.ALL() == null
+                && move.moveToStatement() != null
+                && move.moveToStatement().generalIdentifier().stream().anyMatch(receiver -> receiver == identifier)) {
+            if (!plain) {
+                unsupported(affected, "subscripted-or-modified-receiver");
+                return;
+            }
+            effect(targets.getFirst(), move.moveToStatement().moveToSendingArea(), statement);
+            return;
+        }
+        if (statement instanceof CobolParser.InitializeStatementContext initialize && plain
+                && initialize.getChildCount() == 1 + initialize.generalIdentifier().size()
+                && initialize.generalIdentifier().contains(identifier)) {
+            for (Slot slot : affected) write(slot, statement, "null", null, null);
+            return;
+        }
+        unsupported(affected, statement.getClass().getSimpleName());
+    }
+
+    private void effect(ParserRuleContext target, CobolParser.MoveToSendingAreaContext sending,
+                        ParserRuleContext statement) {
+        List<Slot> affected = under(target);
+        CobolParser.LiteralContext literal = sending.literal();
+        String text = sending.getText();
+        if (literal != null && literal.figurativeConstant() != null) {
+            if (Set.of("SPACE", "SPACES", "LOW-VALUE", "LOW-VALUES").contains(text.toUpperCase(Locale.ROOT)))
+                for (Slot slot : affected) write(slot, statement, "null", null, null);
+            else
+                unsupported(affected, "figurative-" + text.toUpperCase(Locale.ROOT));
+            return;
+        }
+        if (target == record && text.toUpperCase(Locale.ROOT).matches(
+                "DFHCOMMAREA\\(1:(EIBCALEN|LENGTHOF" + Pattern.quote(name) + ")\\)")) {
+            loaded = true;
+            for (Slot slot : affected) {
+                slot.entry = true;
+                write(slot, statement, "entry", null, null);
+            }
+            return;
+        }
+        Slot slot = slots.values().stream().filter(item -> item.definition == target).findFirst().orElse(null);
+        if (slot == null) {
+            unsupported(affected, "group-move");
+            return;
+        }
+        if (literal != null) {
+            if (literal.NONNUMERICLITERAL() == null || !text.matches("(['\"])[^'\"]*\\1")) {
+                unsupported(affected, "literal");
+                return;
+            }
+            String value = text.substring(1, text.length() - 1).replaceFirst(" +$", "");
+            if (value.length() > slot.length) {
+                unsupported(affected, "literal-truncated");
+                return;
+            }
+            write(slot, statement, value.isEmpty() ? "null" : "value", value.isEmpty() ? null : value, null);
+            return;
+        }
+        if (!text.matches("[A-Za-z][A-Za-z0-9-]*")) {
+            unsupported(affected, "sending-expression");
+            return;
+        }
+        String source = text.toUpperCase(Locale.ROOT);
+        List<ParserRuleContext> sources = declarations.hosts(source);
+        if (sources.size() == 1 && slots.containsKey(source) && slots.get(source).definition == sources.getFirst()) {
+            slot.copies.add(source);
+            write(slot, statement, "copy", source, null);
+            return;
+        }
+        CicsConstantResolution.Resolved constant = CicsConstantResolution.resolveName(
+                tree, text, declarations, readOnly, 1, slot.length);
+        if (constant == null) {
+            unsupported(affected, "sending-item-not-constant:" + source);
+            return;
+        }
+        write(slot, statement, "value", constant.value(), constant.proof());
+    }
+
+    private void write(Slot slot, ParserRuleContext statement, String effect, String value,
+                       Map<String, Object> resolution) {
+        if ("value".equals(effect) || "null".equals(effect)) slot.value(value);
+        Map<String, Object> write = new LinkedHashMap<>();
+        write.put("effect", effect);
+        if (value != null) write.put("copy".equals(effect) ? "source" : "value", value);
+        write.put("line", statement.getStart().getLine());
+        write.put("syntax", statement);
+        if (resolution != null) write.put("sourceResolution", resolution);
+        slot.writes.add(write);
+    }
+
+    /* Value set of one slot inside this program alone; null when it depends on entry or is unsupported. */
+    List<String> local(String slotName, Set<String> visiting) {
+        Slot slot = slots.get(slotName);
+        if (slot == null || !issues.isEmpty() || !slot.unsupported.isEmpty() || slot.entry
+                || !visiting.add(slotName)) return null;
+        List<String> result = new ArrayList<>(slot.values);
+        for (String copy : slot.copies) {
+            List<String> values = local(copy, visiting);
+            if (values == null) return null;
+            for (String value : values) if (!result.contains(value)) result.add(value);
+        }
+        visiting.remove(slotName);
+        return result;
+    }
+

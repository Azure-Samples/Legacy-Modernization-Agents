+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+final class CicsTransactionResolution {
+    record Resolution(List<String> names, Map<String, Object> proof) {}
+
+    static Resolution resolve(ParseTree tree, ParserRuleContext command, String operand,
+                              CobolDeclarationIndex declarations) {
+        if (operand.matches("(['\"])[A-Za-z0-9@$#_-]{4}\\1"))
+            return new Resolution(List.of(operand.substring(1, 5)), Map.of("kind", "literal"));
+        List<ParserRuleContext> targets = declarations.hosts(operand);
+        if (!operand.matches("[A-Z][A-Z0-9_-]*") || targets.size() != 1
+                || !local(targets.getFirst())
+                || !targets.getFirst().getText().matches("01" + Pattern.quote(operand)
+                + "PIC(?:TURE)?(?:IS)?X\\(0*4\\)(?:VALUE(?:IS)?SPACES?)?\\."))
+            throw new IllegalArgumentException("dynamic-cics-transaction-binding-unresolved:" + operand);
+        List<ParseTree> loops = nodes(tree).stream()
+                .filter(node -> rule(node).equals("PerformInlineStatementContext")
+                        && nodes(node).contains(command)).toList();
+        if (loops.size() != 1)
+            throw new IllegalArgumentException("cics-transaction-loop-scope-unverified:" + operand);
+        ParseTree loop = loops.getFirst();
+        ParseTree header = children(loop).stream().filter(node -> rule(node).equals("PerformTypeContext"))
+                .findFirst().orElseThrow(() -> new IllegalArgumentException("cics-transaction-loop-header-missing"));
+        Matcher bounds = Pattern.compile("(?:WITH)?(?:TESTBEFORE)?VARYING([A-Z][A-Z0-9_-]*)"
+                + "FROM([1-8])BY1UNTIL\\1>([1-8])(?:WITHTESTBEFORE)?").matcher(header.getText());
+        if (!bounds.matches() || Integer.parseInt(bounds.group(2)) > Integer.parseInt(bounds.group(3)))
+            throw new IllegalArgumentException("cics-transaction-loop-bounds-unverified:" + operand);
+        String counter = bounds.group(1);
+        List<ParserRuleContext> counters = declarations.hosts(counter);
+        if (counters.size() != 1 || !local(counters.getFirst())
+                || !counters.getFirst().getText().matches("01" + Pattern.quote(counter)
+                + "PIC(?:TURE)?(?:IS)?9(?:VALUE(?:IS)?0)?\\."))
+            throw new IllegalArgumentException("cics-transaction-counter-layout-unverified:" + counter);
+        ParseTree first = children(loop).stream()
+                .filter(node -> !(node instanceof TerminalNode) && node != header).findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("cics-transaction-loop-body-missing"));
+        List<ParseTree> strings = nodes(first).stream()
+                .filter(node -> rule(node).equals("StringStatementContext")).toList();
+        if (strings.size() != 1 || nodes(first).stream().anyMatch(node ->
+                Set.of("IfStatementContext", "EvaluateStatementContext", "PerformStatementContext").contains(rule(node))))
+            throw new IllegalArgumentException("cics-transaction-string-not-unconditional:" + operand);
+        ParseTree string = strings.getFirst();
+        Matcher construction = Pattern.compile("STRING(['\"])([A-Za-z0-9@$#_-]{3})\\1"
+                + "DELIMITED(?:BY)?SIZE,?" + Pattern.quote(counter)
+                + "DELIMITED(?:BY)?SIZEINTO" + Pattern.quote(operand) + "(?:END-STRING)?")
+                .matcher(string.getText());
+        if (!construction.matches())
+            throw new IllegalArgumentException("cics-transaction-string-construction-unverified:" + operand);
+        for (ParseTree node : nodes(tree)) {
+            if (node instanceof TerminalNode && "ADDRESS".equalsIgnoreCase(node.getText()))
+                throw new IllegalArgumentException("cics-transaction-address-escape-unverified");
+            if (node instanceof TerminalNode && operand.equalsIgnoreCase(node.getText())
+                    && !nodes(targets.getFirst()).contains(node)
+                    && !nodes(string).contains(node)
+                    && !(nodes(command).contains(node) && nodes(loop).contains(command))
+                    && !readOnly(node, Set.of("DisplayOperandContext")))
+                throw new IllegalArgumentException("cics-transaction-target-mutation-or-escape:" + operand);
+            if (node instanceof TerminalNode && counter.equalsIgnoreCase(node.getText())
+                    && !nodes(counters.getFirst()).contains(node) && !nodes(header).contains(node)
+                    && !readOnly(node, Set.of("StringSendingContext", "EvaluateSelectContext", "DisplayOperandContext")))
+                throw new IllegalArgumentException("cics-transaction-counter-mutation-or-escape:" + counter);
+            if (node instanceof Db2SqlParser.SqlCodeContext sql
+                    && sql.getCustomData().get("REKT_SQL_SEMANTIC_TREE") instanceof ParseTree semantic
+                    && nodes(semantic).stream().anyMatch(reference ->
+                    rule(reference).startsWith("Dbs_host_")
+                            && Set.of(operand, counter).contains(reference.getText().replaceFirst("^:", ""))))
+                throw new IllegalArgumentException("cics-transaction-sql-host-escape-unverified");
+        }
+        List<String> names = new ArrayList<>();
+        for (int value = Integer.parseInt(bounds.group(2)); value <= Integer.parseInt(bounds.group(3)); value++)
+            names.add(construction.group(2) + value);
+        Map<String, Object> proof = new LinkedHashMap<>();
+        proof.put("kind", "bounded-varying-string");
+        proof.put("operand", operand);
+        proof.put("counter", counter);
+        proof.put("definitionSyntax", ParsePipeline.dialectSyntax(targets.getFirst()));
+        proof.put("counterDefinitionSyntax", ParsePipeline.dialectSyntax(counters.getFirst()));
+        proof.put("loopHeaderSyntax", ParsePipeline.dialectSyntax(header));
+        proof.put("stringSyntax", ParsePipeline.dialectSyntax(string));
+        proof.put("usageProof", "single-native-program:unconditional-string-with-read-only-target-and-counter-uses");
+        proof.put("transactionNames", names);
+        return new Resolution(names, proof);
+    }
+
+    private static boolean local(ParseTree declaration) {
+        for (ParseTree parent = declaration.getParent(); parent != null; parent = parent.getParent())
+            if (Set.of("WorkingStorageSectionContext", "LocalStorageSectionContext").contains(rule(parent))) return true;
+        return false;
+    }
+
+    private static boolean readOnly(ParseTree node, Set<String> allowed) {
+        for (ParseTree parent = node.getParent(); parent != null; parent = parent.getParent()) {
+            if (allowed.contains(rule(parent))) return true;
+            if (rule(parent).equals("FunctionCallContext")
+                    || rule(parent).endsWith("StatementContext") && !rule(parent).equals("StatementContext")) return false;
+        }
+        return false;
+    }
+
+    private static String rule(ParseTree node) {
+        return node.getClass().getSimpleName();
+    }
+
+    private static List<ParseTree> children(ParseTree node) {
+        List<ParseTree> result = new ArrayList<>();
+        for (int index = 0; index < node.getChildCount(); index++) result.add(node.getChild(index));
+        return result;
+    }
+
+    private static List<ParseTree> nodes(ParseTree root) {
+        List<ParseTree> result = new ArrayList<>();
+        result.add(root);
+        for (ParseTree child : children(root)) result.addAll(nodes(child));
+        return result;
+    }
+}

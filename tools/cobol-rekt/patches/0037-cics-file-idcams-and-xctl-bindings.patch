+package org.smojol.toolkit.analysis.pipeline;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Reads IDCAMS DEFINE CLUSTER / ALTERNATEINDEX / PATH commands from the instream SYSIN of
+ * EXEC PGM=IDCAMS steps in supplied JCL (REKT_VSAM_DEFINITIONS). Only explicit KEYS and
+ * RECORDSIZE operands are used; a name defined more than once must agree in every extracted attribute.
+ */
+final class VsamClusterCatalog {
+    private record Define(String type, Map<String, String> operands, String path, String sha256, String text) {}
+
+    private static final Pattern STEP = Pattern.compile("//[A-Z0-9@#$]*\\s+EXEC\\s+(.*)", Pattern.CASE_INSENSITIVE);
+    private static final Pattern IDCAMS = Pattern.compile("PGM=IDCAMS(?:[,\\s].*)?", Pattern.CASE_INSENSITIVE);
+    private static final Pattern SYSIN = Pattern.compile("//SYSIN\\s+DD\\s+\\*(?:[,\\s].*)?", Pattern.CASE_INSENSITIVE);
+    private static final Pattern OPERAND = Pattern.compile("\\s*([A-Z][A-Z0-9]*)\\s*(?:\\(([^()]*)\\))?");
+    private static final Pattern COMPONENT = Pattern.compile("\\s*(DATA|INDEX)\\s*\\(([^()]*(?:\\([^()]*\\)[^()]*)*)\\)");
+    private static final Set<String> TYPES = Set.of("CLUSTER", "ALTERNATEINDEX", "PATH");
+
+    private VsamClusterCatalog() {}
+
+    static Optional<Map<String, Object>> dataset(String dsname) throws IOException {
+        String configured = System.getenv("REKT_VSAM_DEFINITIONS");
+        if (configured == null || configured.isBlank()) return Optional.empty();
+        List<Define> defines = new ArrayList<>();
+        for (String value : configured.split(Pattern.quote(File.pathSeparator))) defines.addAll(read(Path.of(value).toRealPath()));
+        Define path = unique(defines, "PATH", dsname);
+        if (path != null) {
+            Define index = unique(defines, "ALTERNATEINDEX", required(path, "PATHENTRY"));
+            if (index == null) throw new IllegalArgumentException("IDCAMS PATH entry is not a defined alternate index: " + dsname);
+            Define base = unique(defines, "CLUSTER", required(index, "RELATE"));
+            if (base == null) throw new IllegalArgumentException("IDCAMS alternate index base cluster is not defined: " + dsname);
+            int[] keys = pair(index, "KEYS");
+            Map<String, Object> attributes = new LinkedHashMap<>();
+            attributes.put("organization", indexedCluster(base));
+            attributes.put("accessPath", "alternate-index-path");
+            attributes.put("recordsize", pair(base, "RECORDSIZE")[1]);
+            attributes.put("keylength", keys[0]);
+            attributes.put("keyOffset", keys[1]);
+            attributes.put("uniqueKeys", uniqueKeys(index));
+            return Optional.of(result(attributes, defines, List.of(path, index, base)));
+        }
+        Define cluster = unique(defines, "CLUSTER", dsname);
+        if (cluster == null) return Optional.empty();
+        if (unique(defines, "ALTERNATEINDEX", dsname) != null)
+            throw new IllegalArgumentException("IDCAMS name defined as both cluster and alternate index: " + dsname);
+        int[] keys = pair(cluster, "KEYS");
+        Map<String, Object> attributes = new LinkedHashMap<>();
+        attributes.put("organization", indexedCluster(cluster));
+        attributes.put("accessPath", "base-cluster");
+        attributes.put("recordsize", pair(cluster, "RECORDSIZE")[1]);
+        attributes.put("keylength", keys[0]);
+        attributes.put("keyOffset", keys[1]);
+        attributes.put("uniqueKeys", true);
+        return Optional.of(result(attributes, defines, List.of(cluster)));
+    }
+
+    private static Map<String, Object> result(Map<String, Object> attributes, List<Define> all, List<Define> used) {
+        List<Map<String, Object>> sources = new ArrayList<>();
+        for (Define define : used)
+            for (Define candidate : all)
+                if (candidate.type().equals(define.type())
+                        && candidate.operands().get("NAME").equals(define.operands().get("NAME"))) {
+                    Map<String, Object> source = new LinkedHashMap<>();
+                    source.put("type", candidate.type());
+                    source.put("name", candidate.operands().get("NAME"));
+                    source.put("sourcePath", candidate.path());
+                    source.put("sourceSha256", candidate.sha256());
+                    source.put("command", candidate.text());
+                    if (!sources.contains(source)) sources.add(source);
+                }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("attributes", attributes);
+        result.put("datasetDefinitions", sources);
+        return result;
+    }
+
+    private static Define unique(List<Define> defines, String type, String name) {
+        Define found = null;
+        for (Define define : defines) {
+            if (!define.type().equals(type) || !name.equals(define.operands().get("NAME"))) continue;
+            if (found != null && !extracted(found).equals(extracted(define)))
+                throw new IllegalArgumentException("Conflicting IDCAMS " + type + " definitions: " + name);
+            if (found == null) found = define;
+        }
+        return found;
+    }
+
+    private static Map<String, Object> extracted(Define define) {
+        Map<String, Object> values = new LinkedHashMap<>();
+        for (String key : List.of("RELATE", "PATHENTRY")) values.put(key, define.operands().get(key));
+        for (String key : List.of("KEYS", "RECORDSIZE"))
+            values.put(key, define.operands().containsKey(key) ? List.of(pair(define, key)[0], pair(define, key)[1]) : null);
+        for (String key : List.of("INDEXED", "NONINDEXED", "NUMBERED", "LINEAR", "UNIQUEKEY", "NONUNIQUEKEY"))
+            values.put(key, define.operands().containsKey(key));
+        return values;
+    }
+
+    // IBM IDCAMS: DEFINE CLUSTER defaults to INDEXED (KSDS); other organizations are not supported here.
+    private static String indexedCluster(Define cluster) {
+        for (String other : List.of("NONINDEXED", "NUMBERED", "LINEAR"))
+            if (cluster.operands().containsKey(other))
+                throw new IllegalArgumentException("Only indexed (KSDS) clusters are supported: " + cluster.operands().get("NAME"));
+        return "KSDS";
+    }
+
+    // IBM IDCAMS: alternate indexes default to UNIQUEKEY.
+    private static boolean uniqueKeys(Define index) {
+        if (index.operands().containsKey("UNIQUEKEY") && index.operands().containsKey("NONUNIQUEKEY"))
+            throw new IllegalArgumentException("Contradictory IDCAMS key uniqueness: " + index.operands().get("NAME"));
+        return !index.operands().containsKey("NONUNIQUEKEY");
+    }
+
+    private static String required(Define define, String key) {
+        String value = define.operands().get(key);
+        if (value == null || !value.matches("[A-Z0-9@#$]{1,8}(?:\\.[A-Z0-9@#$]{1,8})*"))
+            throw new IllegalArgumentException("IDCAMS " + define.type() + " requires " + key + ": " + define.operands().get("NAME"));
+        return value;
+    }
+
+    private static int[] pair(Define define, String key) {
+        String value = define.operands().get(key);
+        Matcher numbers = value == null ? null : Pattern.compile("([0-9]{1,5})\\s*[,\\s]\\s*([0-9]{1,5})").matcher(value.strip());
+        if (numbers == null || !numbers.matches())
+            throw new IllegalArgumentException("IDCAMS " + define.type() + " requires explicit " + key + ": " + define.operands().get("NAME"));
+        int first = Integer.parseInt(numbers.group(1));
+        int second = Integer.parseInt(numbers.group(2));
+        if ("RECORDSIZE".equals(key) && (first <= 0 || second < first)
+                || "KEYS".equals(key) && first <= 0)
+            throw new IllegalArgumentException("Invalid IDCAMS " + key + ": " + define.operands().get("NAME"));
+        return new int[] {first, second};
+    }
+
+    private static List<Define> read(Path path) throws IOException {
+        byte[] bytes = Files.readAllBytes(path);
+        String sha256 = ParsePipeline.sha256(bytes);
+        List<Define> result = new ArrayList<>();
+        boolean idcams = false;
+        List<String> sysin = null;
+        for (String raw : new String(bytes, StandardCharsets.UTF_8).split("\\R", -1)) {
+            String line = raw.length() > 72 ? raw.substring(0, 72) : raw;
+            if (sysin != null) {
+                if (!line.startsWith("/*") && !line.startsWith("//")) {
+                    sysin.add(line);
+                    continue;
+                }
+                result.addAll(commands(sysin, path, sha256));
+                sysin = null;
+            }
+            if (line.startsWith("//*")) continue;
+            Matcher step = STEP.matcher(line.stripTrailing());
+            if (step.matches()) idcams = IDCAMS.matcher(step.group(1).strip()).matches();
+            else if (idcams && SYSIN.matcher(line.stripTrailing()).matches()) sysin = new ArrayList<>();
+        }
+        if (sysin != null) result.addAll(commands(sysin, path, sha256));
+        return result;
+    }
+
+    private static List<Define> commands(List<String> lines, Path path, String sha256) {
+        List<Define> result = new ArrayList<>();
+        StringBuilder command = new StringBuilder();
+        for (String line : lines) {
+            String text = line.replaceAll("/\\*.*?\\*/", " ").strip();
+            if (text.contains("/*") || text.endsWith("+"))
+                throw new IllegalArgumentException("Unsupported IDCAMS comment/continuation syntax: " + path);
+            boolean continued = text.endsWith("-");
+            command.append(continued ? text.substring(0, text.length() - 1) : text).append(' ');
+            if (continued) continue;
+            String complete = command.toString().strip().replaceAll("\\s+", " ");
+            command.setLength(0);
+            Matcher type = Pattern.compile("DEFINE\\s+([A-Z]+)\\b.*", Pattern.CASE_INSENSITIVE).matcher(complete);
+            if (type.matches() && Set.of("CLUSTER", "ALTERNATEINDEX", "AIX", "PATH")
+                    .contains(type.group(1).toUpperCase(Locale.ROOT)))
+                result.add(define(complete, path, sha256));
+        }
+        if (!command.toString().isBlank())
+            throw new IllegalArgumentException("Unterminated IDCAMS continuation: " + path);
+        return result;
+    }
+
+    private static Define define(String text, Path path, String sha256) {
+        Matcher head = Pattern.compile("DEFINE ([A-Z]+) ?\\(", Pattern.CASE_INSENSITIVE).matcher(text);
+        String type = head.lookingAt() && "AIX".equalsIgnoreCase(head.group(1)) ? "ALTERNATEINDEX"
+                : head.lookingAt() ? head.group(1).toUpperCase(Locale.ROOT) : "";
+        if (!TYPES.contains(type))
+            throw new IllegalArgumentException("Unsupported IDCAMS DEFINE: " + text + ": " + path);
+        int depth = 1;
+        int index = head.end();
+        for (; index < text.length() && depth > 0; index++)
+            depth += text.charAt(index) == '(' ? 1 : text.charAt(index) == ')' ? -1 : 0;
+        if (depth != 0) throw new IllegalArgumentException("Unbalanced IDCAMS DEFINE: " + path);
+        String body = text.substring(head.end(), index - 1);
+        Matcher components = COMPONENT.matcher(text.substring(index));
+        int position = 0;
+        String rest = text.substring(index);
+        while (position < rest.length() && !rest.substring(position).isBlank()) {
+            if (!components.find(position) || components.start() != position)
+                throw new IllegalArgumentException("Unsupported IDCAMS DEFINE components: " + text + ": " + path);
+            position = components.end();
+        }
+        Map<String, String> operands = new LinkedHashMap<>();
+        Matcher operand = OPERAND.matcher(body);
+        position = 0;
+        while (position < body.length() && !body.substring(position).isBlank()) {
+            if (!operand.find(position) || operand.start() != position || operand.end() == position)
+                throw new IllegalArgumentException("Unsupported IDCAMS operand syntax: " + text + ": " + path);
+            String keyword = operand.group(1).toUpperCase(Locale.ROOT);
+            if (operands.containsKey(keyword))
+                throw new IllegalArgumentException("Repeated IDCAMS operand " + keyword + ": " + path);
+            operands.put(keyword, operand.group(2) == null ? "" : operand.group(2).strip().replaceAll("\\s+", " "));
+            position = operand.end();
+        }
+        if (!operands.getOrDefault("NAME", "").matches("[A-Z0-9@#$]{1,8}(?:\\.[A-Z0-9@#$]{1,8})*"))
+            throw new IllegalArgumentException("IDCAMS DEFINE requires NAME: " + text + ": " + path);
+        return new Define(type, operands, path.toString(), sha256, text);
+    }
+}

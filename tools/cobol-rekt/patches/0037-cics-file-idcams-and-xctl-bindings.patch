+                && (service == null || !"YES".equals(services.get(service)))) {
+            issues.add("cics-file-operation-not-permitted:" + target.value() + ":" + service);
+            return;
+        }
+        binding.put("targetResolution", target.proof());
+        bindings.add(binding);
+    }

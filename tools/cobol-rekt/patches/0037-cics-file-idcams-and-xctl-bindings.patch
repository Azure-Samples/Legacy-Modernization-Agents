+    private static String fileService(ParserRuleContext syntax, List<String> options) {
+        return switch (syntax.getStart().getText().toUpperCase(Locale.ROOT)) {
+            case "READ" -> options.contains("UPDATE") ? "update" : "read";
+            case "READNEXT", "READPREV", "STARTBR", "ENDBR" -> "browse";
+            case "WRITE" -> "add";
+            case "REWRITE", "UNLOCK" -> "update";
+            case "DELETE" -> "delete";
+            default -> null;
+        };
+    }
+
+    private void bindFile(ParserRuleContext syntax, ParseTree tree, CobolDeclarationIndex declarations,
+                          List<ParseTree> readOnly, List<Map<String, Object>> bindings,
+                          List<String> issues) throws IOException {
+        List<ParseTree> names = nodes(syntax).stream()
+                .filter(node -> node instanceof CICSParser.Cics_file_nameContext).toList();
+        List<String> options = nodes(syntax).stream().filter(node -> node instanceof TerminalNode
+                        && (node.getParent() == syntax || node.getParent() instanceof CICSParser.Cics_write_fileContext
+                        || node.getParent() instanceof CICSParser.Cics_delete_fileContext
+                        || node.getParent() instanceof CICSParser.Cics_delete_ridfldContext
+                        || node.getParent() instanceof CICSParser.Cics_intoContext))
+                .map(node -> node.getText().toUpperCase(Locale.ROOT)).toList();
+        if (names.size() != 1 || !(names.getFirst().getChild(1) instanceof CICSParser.Cics_nameContext operand)
+                || syntax instanceof CICSParser.Cics_deleteContext && syntax.getChildCount() != 2) {
+            issues.add("cics-file-variant-unsupported");
+            return;
+        }
+        String text = operand.name().getText();
+        if (options.contains("SYSID")) {
+            issues.add("remote-cics-file-binding-unresolved:" + text);
+            return;
+        }
+        if (options.stream().anyMatch(FILE_UNSUPPORTED::contains)) {
+            issues.add("cics-file-variant-unsupported");
+            return;
+        }
+        CicsConstantResolution.Resolved target = CicsConstantResolution.literalOrConstant(
+                tree, operand, declarations, readOnly, 1, 8);
+        if (target == null) {
+            issues.add("dynamic-cics-file-binding-unresolved:" + text);
+            return;
+        }
+        Map<String, Object> binding = CicsResourceCatalog.file(target.value()).orElse(null);
+        if (binding == null) {

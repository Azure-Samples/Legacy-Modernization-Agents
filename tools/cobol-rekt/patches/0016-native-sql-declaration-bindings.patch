index 0000000..6d8a997
--- /dev/null
+++ b/smojol-toolkit/src/main/java/org/smojol/toolkit/analysis/pipeline/SqlDependencyAnalysis.java
@@ -0,0 +1,131 @@
+package org.smojol.toolkit.analysis.pipeline;
+
+import org.antlr.v4.runtime.ParserRuleContext;
+import org.antlr.v4.runtime.tree.ParseTree;
+import org.eclipse.lsp.cobol.core.CobolParser;
+import org.eclipse.lsp.cobol.implicitDialects.sql.Db2SqlParser;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+final class SqlDependencyAnalysis {
+    private record Reference(String kind, String name, ParserRuleContext syntax, boolean declaration) {}
+    private record Statement(Map<String, Object> export, List<Reference> references) {}
+    private final List<Statement> statements = new ArrayList<>();
+    private static final Set<String> SUPPORTED_OPERATIONS = Set.of(
+            "DECLARE", "SELECT", "INSERT", "UPDATE", "DELETE",
+            "OPEN", "FETCH", "CLOSE", "COMMIT", "ROLLBACK");
+
+    void record(Db2SqlParser.SqlCodeContext context, Map<String, Object> export) {
+        if (!(context.getCustomData().get("REKT_SQL_SEMANTIC_TREE")
+                instanceof Db2SqlParser.StartSqlRuleContext syntax)) {
+            export.put("semanticStatus", "unavailable");
+            export.put("bindingDiagnostics", List.of("sql-semantic-tree-unavailable"));
+            return;
+        }
+        List<Reference> references = new ArrayList<>();
+        collectReferences(syntax, references);
+        export.put("semanticSyntax", ParsePipeline.dialectSyntax(syntax));
+        export.put("semanticStatus", "complete");
+        export.put("resourceReferences", references.stream().map(reference -> Map.of(
+                "kind", reference.kind(), "name", reference.name(),
+                "role", reference.declaration() ? "declaration" : "reference",
+                "grammarRule", reference.syntax().getClass().getSimpleName())).toList());
+        statements.add(new Statement(export, references));
+    }
+
+    void bind(ParseTree program) {
+        Map<String, List<ParserRuleContext>> definitions = new LinkedHashMap<>();
+        collectHostDeclarations(program, definitions);
+        for (Statement statement : statements) {
+            for (Reference reference : statement.references())
+                if (reference.declaration())
+                    definitions.computeIfAbsent(key(reference.kind(), reference.name()), ignored -> new ArrayList<>())
+                            .add((ParserRuleContext) reference.syntax().getParent());
+        }
+        boolean singleProgram = countPrograms(program) == 1;
+        for (Statement statement : statements) {
+            List<Map<String, Object>> bindings = new ArrayList<>();
+            List<String> issues = new ArrayList<>();
+            String operation = statement.export().get("operation").toString();
+            if (!singleProgram) issues.add("sql-nested-program-scope-unverified");
+            if (!SUPPORTED_OPERATIONS.contains(operation)
+                    || operation.equals("DECLARE") && statement.references().stream().noneMatch(Reference::declaration))
+                issues.add("sql-dependency-operation-unsupported:" + operation);
+            for (Reference reference : statement.references()) {
+                if (reference.declaration()) continue;
+                List<ParserRuleContext> candidates = definitions.getOrDefault(key(reference.kind(), reference.name()), List.of());
+                if (candidates.size() != 1) {
+                    issues.add("sql-" + (candidates.isEmpty() ? "declaration-not-found:" : "declaration-ambiguous:")
+                            + reference.kind() + ":" + reference.name());
+                    continue;
+                }
+                bindings.add(Map.of("kind", reference.kind(), "name", reference.name(),
+                        "definitionScope", "expanded-parser-input",
+                        "definitionSyntax", ParsePipeline.dialectSyntax(candidates.get(0))));
+            }
+            statement.export().put("resourceBindings", bindings);
+            statement.export().put("bindingStatus", issues.isEmpty() ? "complete" : "unresolved");
+            if (!issues.isEmpty()) statement.export().put("bindingDiagnostics", issues.stream().distinct().toList());
+        }
+    }
+
+    private static String key(String kind, String name) {
+        return kind + ":" + name;
+    }
+
+    private static String identifier(String text) {
+        String name = text.startsWith(":") ? text.substring(1) : text;
+        return name.contains("\"") ? name : name.toUpperCase(Locale.ROOT);
+    }
+
+    private void collectReferences(ParseTree node, List<Reference> references) {
+        if (node instanceof ParserRuleContext context) {
+            String kind = context instanceof Db2SqlParser.Dbs_table_nameContext
+                    || context instanceof Db2SqlParser.Dbs_view_nameContext ? "SQL_RELATION"
+                    : context instanceof Db2SqlParser.Dbs_cursor_nameContext ? "SQL_CURSOR"
+                    : context instanceof Db2SqlParser.Dbs_host_var_identifierContext
+                    || context instanceof Db2SqlParser.Dbs_host_variable_arrayContext ? "SQL_HOST_VARIABLE"
+                    : context instanceof Db2SqlParser.Dbs_sequence_nameContext ? "SQL_SEQUENCE"
+                    : context instanceof Db2SqlParser.Dbs_statement_nameContext ? "SQL_STATEMENT"
+                    : context instanceof Db2SqlParser.Dbs_distinct_type_nameContext ? "SQL_TYPE"
+                    : context instanceof Db2SqlParser.Dbs_function_nameContext function
+                    && function.dbs_inbuild_functions() == null ? "SQL_FUNCTION" : null;
+            if (kind != null) {
+                boolean declaration = context.getParent() instanceof Db2SqlParser.Dbs_declare_tableContext
+                        || context instanceof Db2SqlParser.Dbs_cursor_nameContext
+                        && context.getParent() instanceof Db2SqlParser.Dbs_declare_cursorContext;
+                references.add(new Reference(kind, identifier(context.getText()), context, declaration));
+                return;
+            }
+        }
+        for (int index = 0; index < node.getChildCount(); index++)
+            collectReferences(node.getChild(index), references);
+    }
+
+    private void collectHostDeclarations(ParseTree node, Map<String, List<ParserRuleContext>> definitions) {
+        if (node instanceof CobolParser.DataDescriptionEntryFormat1Context entry && entry.entryName() != null)
+            addHost(entry.entryName().getText(), entry, definitions);
+        else if (node instanceof CobolParser.DataDescriptionEntryFormat1Level77Context entry && entry.entryName() != null)
+            addHost(entry.entryName().getText(), entry, definitions);
+        for (int index = 0; index < node.getChildCount(); index++)
+            collectHostDeclarations(node.getChild(index), definitions);
+    }
+
+    private void addHost(String name, ParserRuleContext declaration,
+                         Map<String, List<ParserRuleContext>> definitions) {
+        if (!"FILLER".equalsIgnoreCase(name))
+            definitions.computeIfAbsent(key("SQL_HOST_VARIABLE", identifier(name)), ignored -> new ArrayList<>())
+                    .add(declaration);
+    }
+
+    private int countPrograms(ParseTree node) {
+        int count = node instanceof CobolParser.ProgramUnitContext ? 1 : 0;
+        for (int index = 0; index < node.getChildCount(); index++) count += countPrograms(node.getChild(index));
+        return count;
+    }
+}

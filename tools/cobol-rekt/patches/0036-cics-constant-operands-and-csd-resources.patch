+    /** Reads DFHCSDUP DEFINE statements; every non-comment character must belong to a KEYWORD(value) operand. */
+    private static List<Map<String, Object>> csdDefinitions(String text, Path path) {
+        List<Map<String, Object>> definitions = new java.util.ArrayList<>();
+        Map<String, Object> current = null;
+        StringBuilder content = new StringBuilder();
+        for (String line : text.split("\\R")) if (!line.stripLeading().startsWith("*")) content.append(line).append('\n');
+        java.util.regex.Matcher operand = Pattern.compile("\\s*(?:(DEFINE)\\s+)?([A-Z][A-Z0-9]*)\\(([^()]*)\\)").matcher(content);
+        int position = 0;
+        while (position < content.length() && !content.substring(position).isBlank()) {
+            if (!operand.find(position) || operand.start() != position)
+                throw new IllegalArgumentException("Unsupported CICS CSD syntax near offset " + position + ": " + path);
+            String keyword = operand.group(2).toLowerCase(java.util.Locale.ROOT);
+            String value = operand.group(3).strip();
+            if (operand.group(1) != null) {
+                current = new LinkedHashMap<>();
+                current.put("name", value);
+                definitions.add(Map.of(keyword, current));
+            } else if (current == null || current.containsKey(keyword)) {
+                throw new IllegalArgumentException("CICS CSD operand outside a DEFINE or repeated: " + keyword + ": " + path);
+            } else {
+                current.put(keyword, Set.of("recordsize", "keylength").contains(keyword) && value.matches("[0-9]{1,9}")
+                        ? Integer.valueOf(value) : value);
+            }
+            position = operand.end();
+        }
+        return definitions;
+    }

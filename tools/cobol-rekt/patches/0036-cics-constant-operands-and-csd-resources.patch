+
+/** Resolves a CICS name operand to the VALUE of a never-modified alphanumeric storage item. */
+final class CicsConstantResolution {
+    static final String USAGE_PROOF = "single-native-program:read-only-constant-references";
+
+    record Resolved(String value, Map<String, Object> proof) {}
+
+    private CicsConstantResolution() {}
+
+    static Resolved literalOrConstant(ParseTree tree, ParseTree operand, CobolDeclarationIndex declarations,
+                                      List<ParseTree> readOnlyOperands, int minimum, int maximum) {
+        String literal = CicsTerminalBindings.literal(operand, minimum, maximum);
+        if (literal != null) return new Resolved(literal, Map.of("kind", "literal"));
+        return resolve(tree, operand, declarations, readOnlyOperands, minimum, maximum);
+    }
+
+    static Resolved resolve(ParseTree tree, ParseTree operand, CobolDeclarationIndex declarations,
+                            List<ParseTree> readOnlyOperands, int minimum, int maximum) {
+        String text = operand.getText();
+        if (!text.matches("\\([A-Za-z][A-Za-z0-9-]*\\)") || !declarations.singleProgram()) return null;
+        String name = text.substring(1, text.length() - 1);
+        List<ParserRuleContext> candidates = declarations.hosts(name);
+        if (candidates.size() != 1) return null;
+        ParserRuleContext declaration = candidates.getFirst();
+        String section = storageSection(declaration);
+        Matcher constant = Pattern.compile("(0?[1-9]|[1-4][0-9]|77)" + Pattern.quote(name)
+                + "PIC(?:TURE)?(?:IS)?X\\(0*([1-9][0-9]?)\\)VALUE(?:IS)?(['\"])([A-Za-z0-9@$#_-]+)( *)\\3\\.",
+                Pattern.CASE_INSENSITIVE).matcher(declaration.getText());
+        if (section == null || !constant.matches()) return null;
+        String value = constant.group(4);
+        if (value.length() < minimum || value.length() > maximum
+                || value.length() + constant.group(5).length() > Integer.parseInt(constant.group(2))) return null;
+        List<ParserRuleContext> path = declarations.path(declaration);
+        List<ParserRuleContext> ancestors = path.subList(0, path.size() - 1);
+        int level = Integer.parseInt(constant.group(1));
+        if ((level == 1 || level == 77) != ancestors.isEmpty()) return null;
+        int previous = 0;
+        for (ParserRuleContext ancestor : ancestors) {
+            List<String> tokens = new ArrayList<>();
+            leafTokens(ancestor, tokens);
+            if (!(ancestor instanceof CobolParser.DataDescriptionEntryFormat1Context) || tokens.size() != 3
+                    || !tokens.get(0).matches("0?[1-9]|[1-4][0-9]")
+                    || !tokens.get(1).matches("[A-Za-z][A-Za-z0-9-]*") || !tokens.get(2).equals(".")
+                    || Integer.parseInt(tokens.get(0)) <= previous
+                    || previous == 0 && Integer.parseInt(tokens.get(0)) != 1) return null;
+            previous = Integer.parseInt(tokens.get(0));
+        }
+        if (previous >= level && level != 77) return null;
+        if (!readOnly(tree, path, readOnlyOperands)) return null;
+        Map<String, Object> proof = new LinkedHashMap<>();
+        proof.put("kind", "LocalStorageSectionContext".equals(section)
+                ? "immutable-local-storage-literal" : "immutable-working-storage-literal");
+        proof.put("operand", name);
+        proof.put("definitionSyntax", ParsePipeline.dialectSyntax(declaration));
+        List<Object> ancestorSyntax = new ArrayList<>();
+        for (ParserRuleContext ancestor : ancestors) ancestorSyntax.add(ParsePipeline.dialectSyntax(ancestor));
+        proof.put("ancestorSyntax", ancestorSyntax);
+        proof.put("usageProof", USAGE_PROOF);
+        return new Resolved(value, proof);
+    }
+
+    private static String storageSection(ParserRuleContext declaration) {
+        for (ParseTree ancestor = declaration.getParent(); ancestor != null; ancestor = ancestor.getParent()) {
+            if (ancestor instanceof CobolParser.WorkingStorageSectionContext) return "WorkingStorageSectionContext";
+            if (ancestor instanceof CobolParser.LocalStorageSectionContext) return "LocalStorageSectionContext";
+        }
+        return null;
+    }
+
+    /*
+     * Every occurrence of the item name or of an enclosing group name must be its own declaration,
+     * a resolved CICS name operand, a MOVE sending area, a DISPLAY operand or a condition.
+     * Pointer use, condition names (SET ... TO TRUE) on the chain and SQL host use reject the proof.
+     */
+    private static boolean readOnly(ParseTree tree, List<ParserRuleContext> path, List<ParseTree> readOnlyOperands) {
+        Set<String> names = new java.util.HashSet<>();
+        for (ParserRuleContext entry : path) names.add(entryName(entry));
+        ParserRuleContext owner = null;
+        for (ParseTree node : nodes(tree)) {
+            if (node instanceof CobolParser.DataDescriptionEntryFormat1Context
+                    || node instanceof CobolParser.DataDescriptionEntryFormat1Level77Context
+                    || node instanceof CobolParser.DataDescriptionEntryFormat2Context)
+                owner = (ParserRuleContext) node;
+            if (node instanceof CobolParser.DataDescriptionEntryFormat3Context && path.contains(owner)) return false;
+            if (node instanceof Db2SqlParser.SqlCodeContext sql
+                    && sql.getCustomData().get("REKT_SQL_SEMANTIC_TREE") instanceof ParseTree semantic
+                    && nodes(semantic).stream().anyMatch(reference ->
+                    reference.getClass().getSimpleName().startsWith("Dbs_host_")
+                            && names.contains(reference.getText().replaceFirst("^:", "").toUpperCase(Locale.ROOT))))
+                return false;
+            if (!(node instanceof TerminalNode)) continue;
+            String token = node.getText().toUpperCase(Locale.ROOT);
+            if ("ADDRESS".equals(token)) return false;
+            if (!names.contains(token)) continue;
+            if (path.stream().anyMatch(entry -> contains(entry, node) && entryName(entry).equals(token))) continue;
+            if (readOnlyOperands.stream().anyMatch(root -> contains(root, node))) continue;
+            if (!readPosition(node)) return false;
+        }
+        return true;
+    }
+
+    private static boolean readPosition(ParseTree node) {
+        for (ParseTree ancestor = node.getParent(); ancestor != null; ancestor = ancestor.getParent()) {
+            if (ancestor instanceof CobolParser.MoveToSendingAreaContext
+                    || ancestor instanceof CobolParser.DisplayOperandContext
+                    || ancestor instanceof CobolParser.ConditionContext) return true;
+            if (ancestor.getClass().getSimpleName().endsWith("StatementContext")
+                    || ancestor instanceof CobolParser.DataDescriptionEntryContext) return false;
+        }
+        return false;
+    }
+
+    private static String entryName(ParserRuleContext entry) {
+        if (entry instanceof CobolParser.DataDescriptionEntryFormat1Context field && field.entryName() != null)
+            return field.entryName().getText().toUpperCase(Locale.ROOT);
+        if (entry instanceof CobolParser.DataDescriptionEntryFormat1Level77Context field && field.entryName() != null)
+            return field.entryName().getText().toUpperCase(Locale.ROOT);
+        return "FILLER";
+    }
+
+    private static boolean contains(ParseTree root, ParseTree node) {
+        for (ParseTree ancestor = node; ancestor != null; ancestor = ancestor.getParent())
+            if (ancestor == root) return true;
+        return false;
+    }
+    private static void leafTokens(ParseTree node, List<String> tokens) {
+        if (node instanceof org.antlr.v4.runtime.tree.TerminalNode terminal) {
+            String text = terminal.getText().trim();
+            if (!text.isEmpty()) tokens.add(text);
+            return;
+        }
+        for (int i = 0; i < node.getChildCount(); i++) leafTokens(node.getChild(i), tokens);
+    }
+}

+            if (kind.startsWith("Dialect") || context.getClass().getEnclosingClass() != CobolParser.class)
+                dialectDependencyContexts.add(kind);
+            if (kind.startsWith("File") || FILE_IO_CONTEXTS.contains(kind))
+                fileIoDependencyContexts.add(kind);
+        }
+        for (int index = 0; index < node.getChildCount(); index++)
+            collectAbsenceContexts(node.getChild(index));

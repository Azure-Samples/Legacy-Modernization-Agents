+package org.smojol.common.vm.expression;
+
+import org.smojol.common.vm.structure.CobolDataStructure;
+
+public class UnknownClassCondition extends ClassConditionExpression {
+    private final String sourceText;
+
+    private UnknownClassCondition(CobolExpression expression, String sourceText) {
+        super(expression, "UNKNOWN_CLASS_CONDITION");
+        this.sourceText = sourceText;
+    }
+
+    @Override
+    public CobolExpression evaluate(CobolDataStructure data) {
+        return new NullCobolExpression(description());
+    }
+
+    @Override
+    public String description() {
+        return operationMnemonic + "(" + sourceText + "," + expression.description() + ")";
+    }
+
+    public static ClassConditionExpression preserve(CobolExpression expression, String sourceText) {
+        return new UnknownClassCondition(expression, sourceText);
+    }
+}

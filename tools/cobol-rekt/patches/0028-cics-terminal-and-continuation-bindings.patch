+package org.smojol.toolkit.analysis.pipeline;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.antlr.v4.runtime.ParserRuleContext;
+import org.antlr.v4.runtime.tree.ParseTree;
+import org.antlr.v4.runtime.tree.TerminalNode;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+import static org.smojol.toolkit.analysis.pipeline.CicsDependencyAnalysis.nodes;
+
+final class CicsTerminalBindings {
+    private CicsTerminalBindings() {}
+
+    static void validateVariant(ParserRuleContext syntax, List<String> issues) {
+        Set<String> rules = new LinkedHashSet<>();
+        nodes(syntax).forEach(node -> rules.add(node.getClass().getSimpleName()));
+        boolean supported = switch (syntax.getClass().getSimpleName()) {
+            case "Cics_sendContext" -> rules.contains("Cics_send_control_minContext")
+                    || rules.contains("Cics_send_map_minContext")
+                    || rules.contains("Cics_send_text_stdContext");
+            case "Cics_receiveContext" -> rules.contains("Cics_receive_mapContext")
+                    && !rules.contains("Cics_receive_mappingdevContext")
+                    && operands(syntax, "INPARTN").isEmpty();
+            case "Cics_returnContext" -> !rules.contains("Cics_return_inputmsgContext")
+                    && tokens(syntax).stream().noneMatch(Set.of("CHANNEL", "ENDACTIVITY")::contains);
+            case "Cics_inquireContext" -> rules.contains("Cics_inquire_terminalContext");
+            case "Cics_set_terminalContext" -> true;
+            case "Cics_bifContext" -> rules.contains("Cics_bif_deeditContext")
+                    && operands(syntax, "FIELD").size() == 1;
+            default -> false;
+        };
+        if (!supported) issues.add("cics-terminal-variant-unsupported:" + syntax.getClass().getSimpleName());
+        for (String option : List.of("TRANSID", "MAP", "MAPSET", "TERMINAL", "UCTRANST",
+                "COMMAREA", "LENGTH", "FROM", "INTO", "FIELD", "RESP", "RESP2"))
+            if (operands(syntax, option).size() > 1)
+                issues.add("cics-option-ambiguous:" + option);
+    }
+
+    static boolean supportedHandle(ParseTree syntax) {
+        List<String> tokens = tokens(syntax);
+        long labels = operands(syntax, "LABEL").size();
+        long cancels = tokens.stream().filter("CANCEL"::equals).count();
+        return tokens.stream().noneMatch(Set.of("PROGRAM", "RESET")::contains)
+                && (labels == 1 && cancels == 0 || labels == 0 && cancels == 1);
+    }
+
+    static boolean terminalContext(ParseTree syntax, ParseTree variable) {
+        if (!"EIBTRMID".equalsIgnoreCase(variable.getText())
+                || !Set.of("Cics_inquireContext", "Cics_set_terminalContext")
+                .contains(syntax.getClass().getSimpleName())) return false;
+        return operands(syntax, "TERMINAL").stream().anyMatch(operand -> nodes(operand).contains(variable));
+    }
+
+    static List<ParseTree> operands(ParseTree syntax, String option) {
+        List<ParseTree> result = new ArrayList<>();
+        for (ParseTree node : nodes(syntax))
+            for (int index = 1; index < node.getChildCount(); index++)
+                if (node.getChild(index - 1) instanceof TerminalNode
+                        && option.equalsIgnoreCase(node.getChild(index - 1).getText())
+                        && node.getChild(index) instanceof ParserRuleContext)
+                    result.add("MAP".equals(option)
+                            && "Cics_receive_mapContext".equals(node.getChild(index).getClass().getSimpleName())
+                            ? node.getChild(index).getChild(0) : node.getChild(index));
+        return result;
+    }
+
+    static String literal(ParseTree operand, int minimum, int maximum) {
+        String value = operand.getText();
+        if (!value.matches("\\((['\"])[A-Za-z0-9@$#_-]+\\1\\)")) return null;
+        String name = value.substring(2, value.length() - 2);
+        return name.length() >= minimum && name.length() <= maximum ? name : null;
+    }
+
+    private static List<String> tokens(ParseTree syntax) {
+        return nodes(syntax).stream().filter(node -> node instanceof TerminalNode)
+                .map(node -> node.getText().toUpperCase(Locale.ROOT)).toList();
+    }
+
+    static void bindMap(ParseTree syntax, List<Path> directories,
+                        List<Map<String, Object>> bindings, List<String> issues) throws IOException {
+        List<ParseTree> maps = operands(syntax, "MAP");
+        if (maps.isEmpty()) return;
+        List<ParseTree> mapsets = operands(syntax, "MAPSET");
+        String map = maps.size() == 1 ? literal(maps.getFirst(), 1, 7) : null;
+        String mapset = mapsets.isEmpty() ? map : mapsets.size() == 1 ? literal(mapsets.getFirst(), 1, 7) : null;
+        if (map == null || mapset == null) {
+            issues.add("dynamic-cics-map-binding-unresolved");
+            return;
+        }
+        Set<Path> manifests = new LinkedHashSet<>();
+        for (Path directory : directories) {
+            if (!Files.isDirectory(directory)) continue;
+            try (var files = Files.walk(directory)) {
+                for (Path path : files.filter(Files::isRegularFile)
+                        .filter(path -> path.toString().endsWith(".bms-layout.json")).toList())
+                    manifests.add(path.toRealPath());
+            }
+        }
+        List<Map<String, Object>> matches = new ArrayList<>();
+        for (Path path : manifests) {
+            JsonObject proof = JsonParser.parseString(Files.readString(path)).getAsJsonObject();
+            if (!proof.has("maps") || !proof.get("maps").isJsonArray()) continue;
+            for (var entry : proof.getAsJsonArray("maps")) {
+                JsonObject screen = entry.getAsJsonObject();
+                if (!screen.has("mapset") || !screen.has("name")
+                        || !map.equals(screen.get("name").getAsString())
+                        || !mapset.equals(screen.get("mapset").getAsString())) continue;
+                Path output = Path.of(path.toString().replaceFirst("\\.bms-layout\\.json$", ""));
+                Path source = Path.of(output + ".bms-source");
+                if (!Files.isRegularFile(source)) continue;
+                if (!proof.has("schemaVersion") || proof.get("schemaVersion").getAsInt() != 1
+                        || !proof.has("producer") || !"bms-symbolic-map/layout-v1".equals(proof.get("producer").getAsString())
+                        || !proof.has("status") || !"complete".equals(proof.get("status").getAsString())
+                        || !proof.has("sourceSha256") || !proof.has("outputSha256")
+                        || !Files.isRegularFile(source) || !Files.isRegularFile(output)
+                        || !ParsePipeline.sha256(Files.readAllBytes(source)).equals(proof.get("sourceSha256").getAsString())
+                        || !ParsePipeline.sha256(Files.readAllBytes(output)).equals(proof.get("outputSha256").getAsString()))
+                    throw new IllegalArgumentException("Unverified BMS map layout: " + path);
+                String mode = screen.get("mode").getAsString();
+                if ("Cics_receiveContext".equals(syntax.getClass().getSimpleName())
+                        ? !Set.of("IN", "INOUT").contains(mode) : !Set.of("OUT", "INOUT").contains(mode))
+                    throw new IllegalArgumentException("BMS map direction mismatch: " + map);
+                Map<String, Object> binding = new LinkedHashMap<>();
+                binding.put("kind", "CICS_MAP");
+                binding.put("name", map);
+                binding.put("mapset", mapset);
+                binding.put("sourcePath", source.toRealPath().toString());
+                binding.put("sourceSha256", ParsePipeline.sha256(Files.readAllBytes(source)));
+                binding.put("layoutPath", path.toString());
+                binding.put("layoutSha256", ParsePipeline.sha256(Files.readAllBytes(path)));
+                binding.put("outputPath", output.toRealPath().toString());
+                binding.put("outputSha256", ParsePipeline.sha256(Files.readAllBytes(output)));
+                binding.put("definition", screen.deepCopy());
+                matches.add(binding);
+            }
+        }
+        if (matches.size() != 1) {
+            issues.add("cics-map-definition-" + (matches.isEmpty() ? "not-found:" : "ambiguous:") + mapset + ":" + map);
+            return;
+        }
+        bindings.add(matches.getFirst());
+    }
+}

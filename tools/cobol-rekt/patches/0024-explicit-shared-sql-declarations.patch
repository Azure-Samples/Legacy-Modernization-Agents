+    private Map<String, List<Definition>> loadCatalog() {
+        Map<String, List<Definition>> result = new LinkedHashMap<>();
+        String configured = System.getenv("REKT_SQL_DECLARATIONS");
+        if (configured == null || configured.isBlank() || statements.isEmpty()) return result;
+        Set<Path> seen = new java.util.HashSet<>();
+        for (String input : configured.split(Pattern.quote(File.pathSeparator), -1)) {
+            if (input.isBlank()) throw new IllegalArgumentException("Empty configured SQL declaration path");
+            try {
+                Path path = Path.of(input).toRealPath();
+                if (!seen.add(path)) throw new IllegalArgumentException("Duplicate SQL declaration path: " + path);
+                byte[] bytes = Files.readAllBytes(path);
+                String text = new String(bytes, StandardCharsets.UTF_8);
+                String normalized = text.lines().filter(line -> !fixed(line)
+                                || "* /Dd".indexOf(line.charAt(6)) < 0 || line.charAt(6) == ' ')
+                        .map(line -> fixed(line) ? line.substring(7, Math.min(72, line.length())) : line)
+                        .collect(Collectors.joining("\n"));
+                List<String> problems = new ArrayList<>();
+                List<String> bodies = new ArrayList<>();
+                if (path.toString().toLowerCase(Locale.ROOT).endsWith(".sql")) {
+                    bodies.add(text);
+                } else {
+                    Db2SqlParser parser = sqlParser(normalized, problems);
+                    collectCatalogBodies(parser.startRule(), bodies);
+                }
+                if (!problems.isEmpty() || bodies.isEmpty())
+                    throw new IllegalArgumentException("SQL catalog has no valid EXEC SQL declarations: " + path + ": " + problems);
+                for (String body : bodies) {
+                    Db2SqlParser parser = sqlParser(body, problems);
+                    Db2SqlParser.StartSqlRuleContext syntax = parser.startSqlRule();
+                    List<Reference> references = new ArrayList<>();
+                    collectReferences(syntax, references);
+                    if (!problems.isEmpty() || syntax.getChildCount() != 2 || references.size() != 1
+                            || !references.get(0).declaration() || !"SQL_RELATION".equals(references.get(0).kind()))
+                        throw new IllegalArgumentException("Only complete DECLARE TABLE statements are supported in SQL catalogs: "
+                                + path + ": " + problems);
+                    Reference reference = references.get(0);
+                    result.computeIfAbsent(key(reference.kind(), reference.name()), ignored -> new ArrayList<>())
+                            .add(new Definition((ParserRuleContext) reference.syntax().getParent(),
+                                    path.toString(), ParsePipeline.sha256(bytes)));
+                }
+            } catch (IOException exception) {
+                throw new UncheckedIOException("Cannot read configured SQL declaration catalog: " + input, exception);
+            } catch (org.antlr.v4.runtime.misc.ParseCancellationException exception) {
+                throw new IllegalArgumentException("Cannot parse configured SQL declaration catalog: " + input, exception);
+            }
+        }
+        return result;
+    }
+
+    private static boolean fixed(String line) {
+        return line.length() > 7 && line.substring(0, 6).chars()
+                .allMatch(character -> character == ' ' || character >= '0' && character <= '9')
+                && " *-/Dd".indexOf(line.charAt(6)) >= 0;
+    }
+
+    private static Db2SqlParser sqlParser(String text, List<String> problems) {
+        BaseErrorListener listener = new BaseErrorListener() {
+            @Override
+            public void syntaxError(Recognizer<?, ?> recognizer, Object symbol, int line, int column,
+                                    String message, RecognitionException exception) {
+                problems.add(line + ":" + column + ":" + message);
+            }
+        };
+        Db2SqlLexer lexer = new Db2SqlLexer(CharStreams.fromString(text));
+        lexer.removeErrorListeners();
+        lexer.addErrorListener(listener);
+        Db2SqlParser parser = new Db2SqlParser(new CommonTokenStream(lexer));
+        parser.removeErrorListeners();
+        parser.addErrorListener(listener);
+        parser.setErrorHandler(new BailErrorStrategy());
+        return parser;
+    }
+
+    private static void collectCatalogBodies(ParseTree tree, List<String> bodies) {
+        if (tree instanceof Db2SqlParser.ExecRuleContext command && command.sqlCode() != null) {
+            bodies.add(NodeText.originalText(command.sqlCode()));
+            return;
+        }
+        for (int index = 0; index < tree.getChildCount(); index++) collectCatalogBodies(tree.getChild(index), bodies);
+    }
+
     private static String key(String kind, String name) {
         return kind + ":" + name;
     }

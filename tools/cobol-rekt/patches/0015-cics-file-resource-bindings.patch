+package org.smojol.toolkit.analysis.pipeline;
+
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.regex.Pattern;
+
+final class CicsResourceCatalog {
+    private CicsResourceCatalog() {}
+
+    static Optional<Map<String, Object>> file(String name) throws IOException {
+        String configured = System.getenv("REKT_CICS_RESOURCE_DEFINITIONS");
+        if (configured == null || configured.isBlank()) return Optional.empty();
+        LoaderOptions options = new LoaderOptions();
+        options.setAllowDuplicateKeys(false);
+        options.setMaxAliasesForCollections(0);
+        options.setCodePointLimit(1_048_576);
+        Map<String, Object> binding = null;
+        for (String value : configured.split(Pattern.quote(File.pathSeparator))) {
+            Path path = Path.of(value).toRealPath();
+            byte[] bytes = Files.readAllBytes(path);
+            Object loaded = new Yaml(new SafeConstructor(options))
+                    .load(new String(bytes, StandardCharsets.UTF_8));
+            if (!(loaded instanceof Map<?, ?> root)
+                    || !(root.get("resourceDefinitions") instanceof List<?> definitions))
+                throw new IllegalArgumentException("CICS resourceDefinitions list required: " + path);
+            for (Object definition : definitions) {
+                if (!(definition instanceof Map<?, ?> entry))
+                    throw new IllegalArgumentException("CICS resource definition must be a mapping: " + path);
+                if (!entry.containsKey("file")) continue;
+                if (!(entry.get("file") instanceof Map<?, ?> file)
+                        || !(file.get("name") instanceof String fileName) || fileName.isBlank())
+                    throw new IllegalArgumentException("CICS file definition requires a name: " + path);
+                if (!name.equals(fileName)) continue;
+                if (binding != null)
+                    throw new IllegalArgumentException("Ambiguous CICS file definition: " + name);
+                if (!(file.get("dsname") instanceof String dataset) || dataset.isBlank())
+                    throw new IllegalArgumentException("CICS file definition requires dsname: " + name);
+                int recordSize = integer(file.get("recordsize"), "recordsize", name);
+                int keyLength = integer(file.get("keylength"), "keylength", name);
+                if (recordSize <= 0 || keyLength < 0 || keyLength > recordSize)
+                    throw new IllegalArgumentException("Invalid CICS file record/key lengths: " + name);
+                binding = new LinkedHashMap<>();
+                binding.put("kind", "CICS_FILE");
+                binding.put("name", name);
+                binding.put("sourcePath", path.toString());
+                binding.put("sourceSha256", ParsePipeline.sha256(bytes));
+                binding.put("attributes", Map.of("dsname", dataset,
+                        "recordsize", recordSize, "keylength", keyLength));
+            }
+        }
+        return Optional.ofNullable(binding);
+    }
+
+    private static int integer(Object value, String field, String name) {
+        if (!(value instanceof Integer))
+            throw new IllegalArgumentException("CICS file " + field + " must be an integer: " + name);
+        return (Integer) value;
+    }
+}

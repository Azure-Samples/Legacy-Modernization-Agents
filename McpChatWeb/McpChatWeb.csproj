<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- See CobolToQuarkusMigration.csproj: avoids launching an unsigned native
         AppHost that enterprise endpoint security may block with "Access is
         denied" when doctor.sh runs `dotnet run` for McpChatWeb. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Neo4j.Driver" Version="5.15.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.0" />
  </ItemGroup>

  <!-- Pull in shared helpers from the main project as linked source so we can use
       RektContextLoader / StructuralContextProvider / BmsReader / etc. without
       taking a project reference (which would drag in the whole agent runtime). -->
  <ItemGroup>
    <Compile Include="..\Helpers\RektContext.cs"                 Link="Shared\RektContext.cs" />
    <Compile Include="..\Helpers\RektContextLoader.cs"           Link="Shared\RektContextLoader.cs" />
    <Compile Include="..\Helpers\StructuralContextProvider.cs"   Link="Shared\StructuralContextProvider.cs" />
    <Compile Include="..\Helpers\BmsReader.cs"                   Link="Shared\BmsReader.cs" />
    <Compile Include="..\Helpers\ImsReaders.cs"                  Link="Shared\ImsReaders.cs" />
    <Compile Include="..\Helpers\CopilotRouting.cs"              Link="Shared\CopilotRouting.cs" />
    <Compile Include="..\Helpers\CopilotProvider.cs"             Link="Shared\CopilotProvider.cs" />
    <Compile Include="..\Helpers\CopilotModelDiagnostics.cs"     Link="Shared\CopilotModelDiagnostics.cs" />
    <Compile Include="..\Helpers\CopilotCliInfo.cs"              Link="Shared\CopilotCliInfo.cs" />
  </ItemGroup>

</Project>

# =============================================================================
# Azure OpenAI Configuration (Optimized)
# =============================================================================
# INSTRUCTIONS:
# 1. Edit the "MASTER CONFIGURATION" section below with your details.
# 2. The "SYSTEM MAPPING" section automatically applies these to all tools.
# =============================================================================

# =============================================================================
# 1. MASTER CONFIGURATION (Edit these values)
# =============================================================================

# Service Credentials
_MAIN_ENDPOINT="https://your-endpoint.cognitiveservices.azure.com"
_MAIN_API_KEY="key-placeholder"
# NOTE: Leave _MAIN_API_KEY empty (or as placeholder) to use Azure AD / Entra ID
#       authentication via 'az login'. See azlogin-auth-guide.md for details.

# Model Selection
# Chat Model: Used for Portal Q&A, Reports, and Reasoning
_CHAT_MODEL="gpt-5.2-chat"

# Code Model: Used for COBOL Analysis, Java Conversion, and Unit Tests
# Recommended: gpt-4o, gpt-4-turbo, or codex-specific models
_CODE_MODEL="gpt-5.1-codex-mini"

# =============================================================================
# 2. SYSTEM MAPPING (Advanced - Do not edit unless necessary)
# =============================================================================

# --- AI Service Configuration ---
# Supported values: "AzureOpenAI" (default), "GitHubCopilot"
# For GitHubCopilot: endpoint/key are ignored; requires Copilot CLI in PATH.
# Run './doctor.sh setup' to configure your provider.
AZURE_OPENAI_SERVICE_TYPE="AzureOpenAI"
AZURE_OPENAI_ENDPOINT="$_MAIN_ENDPOINT"
AZURE_OPENAI_API_KEY="$_MAIN_API_KEY"
AZURE_OPENAI_MAX_TOKENS="16384"
# API version for the Azure OpenAI data plane. Defaults to 2025-04-01-preview.
# AZURE_OPENAI_API_VERSION="2025-04-01-preview"

# --- Default Deployment (Legacy/Doctor Checks) ---
AZURE_OPENAI_DEPLOYMENT_NAME="$_CHAT_MODEL"
AZURE_OPENAI_MODEL_ID="$_CHAT_MODEL"

# --- Specialized Agent Models (Mapped to Code Model) ---
AZURE_OPENAI_COBOL_ANALYZER_MODEL="$_CODE_MODEL"
AZURE_OPENAI_JAVA_CONVERTER_MODEL="$_CODE_MODEL"
AZURE_OPENAI_DEPENDENCY_MAPPER_MODEL="$_CODE_MODEL"
AZURE_OPENAI_UNIT_TEST_MODEL="$_CODE_MODEL"

# --- Portal & Reporting Configuration (Mapped to Chat Model) ---
AISETTINGS__CHATENDPOINT="$_MAIN_ENDPOINT"
AISETTINGS__CHATAPIKEY="$_MAIN_API_KEY"
AISETTINGS__CHATMODELID="$_CHAT_MODEL"
AISETTINGS__CHATDEPLOYMENTNAME="$_CHAT_MODEL"

# --- Code Agents Configuration (Mapped to Code Model) ---
AISETTINGS__ENDPOINT="$_MAIN_ENDPOINT"
AISETTINGS__APIKEY="$_MAIN_API_KEY"
AISETTINGS__MODELID="$_CODE_MODEL"
AISETTINGS__DEPLOYMENTNAME="$_CODE_MODEL"

# Individual Agent Overrides (defaults to Code Model)
AISETTINGS__COBOLANALYZERMODELID="$_CODE_MODEL"
AISETTINGS__JAVACONVERTERMODELID="$_CODE_MODEL"
AISETTINGS__UNITTESTMODELID="$_CODE_MODEL"
AISETTINGS__DEPENDENCYMAPPERMODELID="$_CODE_MODEL"

# =============================================================================
# 3. APPLICATION SETTINGS
# =============================================================================
COBOL_SOURCE_FOLDER="source"
JAVA_OUTPUT_FOLDER="output/java"
CSHARP_OUTPUT_FOLDER="output/csharp"
TEST_OUTPUT_FOLDER="TestOutput"

# Neo4j local development credentials
# Username: neo4j
# NOT FOR PRODUCTION, ENSURE TO CHANGE PASSWORD
NEO4J_PASSWORD="cobol-rekt-2026"

# --- Throughput (optional) ---
# Each overrides the matching ChunkingSettings entry in Config/appsettings.json.
# Leave unset to use the appsettings.json value.
# AI_MAX_PARALLEL_CONVERSION="4"
# AI_MAX_PARALLEL_ANALYSIS="4"
# AI_MAX_PARALLEL_CHUNKS="4"
# AI_STAGGER_DELAY_MS="250"
# AI_RATE_LIMIT_SAFETY_FACTOR="0.8"
# AZURE_OPENAI_CONTEXT_WINDOW_SIZE="128000"

# --- Migration behaviour (optional) ---
# TARGET_LANGUAGE: "java" (default) or "csharp". A value set in the shell wins over this file.
# ENABLE_REKT_CONTEXT: structural facts from the REKT parse are injected into conversion
# prompts by default. Set to "false" to convert from source and reverse-engineering
# context alone, which is mainly useful for comparing against an older run.
# TARGET_LANGUAGE="java"
# ENABLE_REKT_CONTEXT="false"

# --- Generated code layout (optional) ---
# TARGET_ROOT_NAMESPACE: the root every generated type sits under. Defaults to
# "com.modernized" for Java and "Modernized" for C#, and is cased for the target language,
# so "bankdata.core" becomes com.modernized-style "bankdata.core" in Java and
# "Bankdata.Core" in C#.
#
# Beneath the root, a program's service is the folder it occupies in the source drop:
# source/bd/BDSDA23.cbl becomes <root>.bd / <root>.Bd. A generic container directory such
# as SRC yields to its parent, because naming a service "src" says nothing about it. Types
# built from a copybook used by more than one program live in <root>.shared so they exist
# once rather than once per caller.
#
# This is assigned to the model rather than requested from it. Asked to choose, one estate
# produced 33 packages under five unrelated roots.
# TARGET_ROOT_NAMESPACE="com.example.banking"

# --- Conversion Parity (preview) ---
# Structural coverage of generated code against the COBOL it came from.
# Reported after conversion; it never alters the generated output.
# MIN_PROGRAM_SCORE: programs scoring below this are flagged. 0 still flags a program
#   whose every symbol on an axis is absent from code, which no score can express.
# ON_LOW_SCORE: "warn" (default) reports only; "stop" additionally sets exit code 4.
# MIN_PROGRAM_SCORE="0.75"
# ON_LOW_SCORE="warn"

# =============================================================================
# Security Notes:
# - Never commit real API keys to version control
# - Use ai-config.local.env for actual values (gitignored)
# - Consider using Azure Key Vault for production environments
# - Rotate API keys regularly
# =============================================================================

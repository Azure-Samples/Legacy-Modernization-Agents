# =============================================================================
# 1. MASTER CONFIGURATION
# =============================================================================

_MAIN_ENDPOINT="http://localhost:1234/v1"
_MAIN_API_KEY="lm-studio"
_CHAT_MODEL="llama-3.2-3b-instruct"
_CODE_MODEL="llama-3.2-3b-instruct"

# =============================================================================
# 2. SYSTEM MAPPING
# =============================================================================

# --- Azure OpenAI Service Configuration ---
AZURE_OPENAI_SERVICE_TYPE="OpenAI"
AZURE_OPENAI_ENDPOINT="http://localhost:1234/v1"
AZURE_OPENAI_API_KEY="lm-studio"
AZURE_OPENAI_MAX_TOKENS="16384"
AZURE_OPENAI_TEMPERATURE="0.1"

# --- Primary Deployment ---
AZURE_OPENAI_DEPLOYMENT_NAME="llama-3.2-3b-instruct"
AZURE_OPENAI_MODEL_ID="llama-3.2-3b-instruct"

# --- Chat Deployment ---
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="llama-3.2-3b-instruct"
AZURE_OPENAI_CHAT_MODEL_ID="llama-3.2-3b-instruct"

# --- Specialized Agent Models ---
AZURE_OPENAI_COBOL_ANALYZER_MODEL="llama-3.2-3b-instruct"
AZURE_OPENAI_JAVA_CONVERTER_MODEL="llama-3.2-3b-instruct"
AZURE_OPENAI_DEPENDENCY_MAPPER_MODEL="llama-3.2-3b-instruct"
AZURE_OPENAI_UNIT_TEST_MODEL="llama-3.2-3b-instruct"

# --- Portal & Reporting Configuration ---
AISETTINGS__CHATENDPOINT="http://localhost:1234/v1"
AISETTINGS__CHATAPIKEY="lm-studio"
AISETTINGS__CHATMODELID="llama-3.2-3b-instruct"
AISETTINGS__CHATDEPLOYMENTNAME="llama-3.2-3b-instruct"

# --- Code Agents Configuration ---
AISETTINGS__ENDPOINT="http://localhost:1234/v1"
AISETTINGS__APIKEY="lm-studio"
AISETTINGS__MODELID="llama-3.2-3b-instruct"
AISETTINGS__DEPLOYMENTNAME="llama-3.2-3b-instruct"

# Individual Agent Overrides
AISETTINGS__COBOLANALYZERMODELID="llama-3.2-3b-instruct"
AISETTINGS__JAVACONVERTERMODELID="llama-3.2-3b-instruct"
AISETTINGS__UNITTESTMODELID="llama-3.2-3b-instruct"
AISETTINGS__DEPENDENCYMAPPERMODELID="llama-3.2-3b-instruct"

# =============================================================================
# 3. APPLICATION SETTINGS
# =============================================================================
COBOL_SOURCE_FOLDER="source"
JAVA_OUTPUT_FOLDER="output/java"
CSHARP_OUTPUT_FOLDER="output/csharp"
TEST_OUTPUT_FOLDER="TestOutput"

LOG_LEVEL="Information"
ENABLE_CHAT_LOGGING="true"
ENABLE_API_CALL_LOGGING="true"

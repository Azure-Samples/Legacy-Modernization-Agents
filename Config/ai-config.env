# =============================================================================
# 1. MASTER CONFIGURATION
# =============================================================================

_MAIN_ENDPOINT="http://localhost:1234/v1"
_MAIN_API_KEY="lm-studio"
_CHAT_MODEL="microsoft/phi-4-mini-reasoning"
_CODE_MODEL="microsoft/phi-4-mini-reasoning"

# =============================================================================
# 2. SYSTEM MAPPING (Fixed: Variables replaced with actual values)
# =============================================================================

# --- Azure OpenAI Service Configuration ---
# CHANGED TO "OpenAI" to stop Azure RBAC/Deployment errors
AZURE_OPENAI_SERVICE_TYPE="OpenAI"
AZURE_OPENAI_ENDPOINT="http://localhost:1234/v1"
AZURE_OPENAI_API_KEY="lm-studio"
AZURE_OPENAI_MAX_TOKENS="16384"
AZURE_OPENAI_TEMPERATURE="0.1"

# --- Primary Deployment ---
AZURE_OPENAI_DEPLOYMENT_NAME="microsoft/phi-4-mini-reasoning"
AZURE_OPENAI_MODEL_ID="microsoft/phi-4-mini-reasoning"

# --- Chat Deployment ---
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="microsoft/phi-4-mini-reasoning"
AZURE_OPENAI_CHAT_MODEL_ID="microsoft/phi-4-mini-reasoning"

# --- Specialized Agent Models ---
AZURE_OPENAI_COBOL_ANALYZER_MODEL="microsoft/phi-4-mini-reasoning"
AZURE_OPENAI_JAVA_CONVERTER_MODEL="microsoft/phi-4-mini-reasoning"
AZURE_OPENAI_DEPENDENCY_MAPPER_MODEL="microsoft/phi-4-mini-reasoning"
AZURE_OPENAI_UNIT_TEST_MODEL="microsoft/phi-4-mini-reasoning"

# --- Portal & Reporting Configuration ---
AISETTINGS__CHATENDPOINT="http://localhost:1234/v1"
AISETTINGS__CHATAPIKEY="lm-studio"
AISETTINGS__CHATMODELID="microsoft/phi-4-mini-reasoning"
AISETTINGS__CHATDEPLOYMENTNAME="microsoft/phi-4-mini-reasoning"

# --- Code Agents Configuration ---
AISETTINGS__ENDPOINT="http://localhost:1234/v1"
AISETTINGS__APIKEY="lm-studio"
AISETTINGS__MODELID="microsoft/phi-4-mini-reasoning"
AISETTINGS__DEPLOYMENTNAME="microsoft/phi-4-mini-reasoning"

# Individual Agent Overrides
AISETTINGS__COBOLANALYZERMODELID="microsoft/phi-4-mini-reasoning"
AISETTINGS__JAVACONVERTERMODELID="microsoft/phi-4-mini-reasoning"
AISETTINGS__UNITTESTMODELID="microsoft/phi-4-mini-reasoning"
AISETTINGS__DEPENDENCYMAPPERMODELID="microsoft/phi-4-mini-reasoning"

# =============================================================================
# 3. APPLICATION SETTINGS
# =============================================================================
COBOL_SOURCE_FOLDER="source"
JAVA_OUTPUT_FOLDER="output/java"
CSHARP_OUTPUT_FOLDER="output/csharp"
TEST_OUTPUT_FOLDER="TestOutput"

LOG_LEVEL="Information"
ENABLE_CHAT_LOGGING="true"
ENABLE_API_CALL_LOGGING="true"

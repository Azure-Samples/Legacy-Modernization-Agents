# =============================================================================
# 1. MASTER CONFIGURATION
# =============================================================================

_MAIN_ENDPOINT="http://localhost:1234/v1"
_MAIN_API_KEY="local-lmstudio-key"
_CHAT_MODEL="google/gemma-4-e4b"
_CODE_MODEL="google/gemma-4-e4b"

# =============================================================================
# 2. SYSTEM MAPPING (Fixed: Variables replaced with actual values)
# =============================================================================

# --- Azure OpenAI Service Configuration ---
# CHANGED TO "OpenAI" to stop Azure RBAC/Deployment errors
AZURE_OPENAI_SERVICE_TYPE="OpenAI"
AZURE_OPENAI_ENDPOINT="http://localhost:1234/v1"
AZURE_OPENAI_API_KEY="local-lmstudio-key"
AZURE_OPENAI_MAX_TOKENS="16384"
AZURE_OPENAI_TEMPERATURE="0.1"

# --- Primary Deployment ---
AZURE_OPENAI_DEPLOYMENT_NAME="google/gemma-4-e4b"
AZURE_OPENAI_MODEL_ID="google/gemma-4-e4b"

# --- Chat Deployment ---
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="google/gemma-4-e4b"
AZURE_OPENAI_CHAT_MODEL_ID="google/gemma-4-e4b"

# --- Specialized Agent Models ---
AZURE_OPENAI_COBOL_ANALYZER_MODEL="google/gemma-4-e4b"
AZURE_OPENAI_JAVA_CONVERTER_MODEL="google/gemma-4-e4b"
AZURE_OPENAI_DEPENDENCY_MAPPER_MODEL="google/gemma-4-e4b"
AZURE_OPENAI_UNIT_TEST_MODEL="google/gemma-4-e4b"

# --- Portal & Reporting Configuration ---
AISETTINGS__CHATENDPOINT="https://confused-flanked-yogurt.ngrok-free.dev/v1"
AISETTINGS__CHATAPIKEY="local-lmstudio-key"
AISETTINGS__CHATMODELID="google/gemma-4-e4b"
AISETTINGS__CHATDEPLOYMENTNAME="google/gemma-4-e4b"

# --- Code Agents Configuration ---
AISETTINGS__ENDPOINT="http://localhost:1234/v1"
AISETTINGS__APIKEY="local-lmstudio-key"
AISETTINGS__MODELID="google/gemma-4-e4b"
AISETTINGS__DEPLOYMENTNAME="google/gemma-4-e4b"

# Individual Agent Overrides
AISETTINGS__COBOLANALYZERMODELID="google/gemma-4-e4b"
AISETTINGS__JAVACONVERTERMODELID="google/gemma-4-e4b"
AISETTINGS__UNITTESTMODELID="google/gemma-4-e4b"
AISETTINGS__DEPENDENCYMAPPERMODELID="google/gemma-4-e4b"

# =============================================================================
# 3. APPLICATION SETTINGS
# =============================================================================
COBOL_SOURCE_FOLDER="source"
JAVA_OUTPUT_FOLDER="output/java"
CSHARP_OUTPUT_FOLDER="output/csharp"
TEST_OUTPUT_FOLDER="TestOutput"

LOG_LEVEL="Information"
ENABLE_CHAT_LOGGING="true"
ENABLE_API_CALL_LOGGING="true"
